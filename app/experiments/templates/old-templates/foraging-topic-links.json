{
  "id": "foraging-topic-links",
  "name": "Foraging Topic Links",
  "version": "1.0.0",
  "description": "Creates all EMQX topic links for foraging: OptiTrack→rosbot, viz links (puck/aruco/odom/optitrack), and LED reactive links (perception/puck/aruco colors).",
  "tags": ["foraging", "topic-links"],
  "parameters": {
    "robot_id":           { "type": "string", "default": "rosbot",   "required": true,  "description": "Robot agent ID" },
    "hydra_agent_id":     { "type": "string", "default": "hydra",    "required": true,  "description": "Hydra agent (OptiTrack source)" },
    "optitrack_agent_id": { "type": "string", "default": "hydra",    "required": false, "description": "OptiTrack recording agent" },
    "socrates_agent_id":  { "type": "string", "default": "socrates", "required": false, "description": "Viz agent — empty to skip viz links" },
    "led_agent_id":       { "type": "string", "default": "led_truss","required": false, "description": "LED agent — empty to skip LED links" }
  },
  "steps": [
    {
      "name": "create_all_topic_links",
      "type": "parallel",
      "on_failure": "abort",
      "steps": [
        {
          "name": "link_optitrack_to_rosbot",
          "type": "topic_link",
          "on_failure": "abort",
          "operation": "create",
          "source_topic": "lucid/agents/${hydra_agent_id}/components/ros_bridge/telemetry/optitrack_umh_5",
          "target_topic": "lucid/agents/${robot_id}/components/ros_bridge/cmd/optitrack_pose",
          "select_clause": "payload.value as value",
          "payload_template": "{\"data\": ${value}}",
          "qos": 0
        },
        {
          "name": "link_puck_registry_viz",
          "type": "topic_link",
          "when": "${socrates_agent_id}",
          "on_failure": "continue",
          "operation": "create",
          "source_topic": "lucid/agents/${robot_id}/components/ros_bridge/telemetry/puck_registry",
          "target_topic": "lucid/agents/${socrates_agent_id}/components/viz/telemetry/puck_registry",
          "select_clause": "payload.value as value",
          "payload_template": "{\"value\": ${value}}",
          "qos": 0
        },
        {
          "name": "link_aruco_confirmed_viz",
          "type": "topic_link",
          "when": "${socrates_agent_id}",
          "on_failure": "continue",
          "operation": "create",
          "source_topic": "lucid/agents/${robot_id}/components/ros_bridge/telemetry/aruco_confirmed",
          "target_topic": "lucid/agents/${socrates_agent_id}/components/viz/telemetry/aruco_confirmed",
          "select_clause": "payload.value.marker_id as marker_id, payload.value.x as x, payload.value.y as y",
          "payload_template": "{\"marker_id\": ${marker_id}, \"x\": ${x}, \"y\": ${y}}",
          "qos": 0
        },
        {
          "name": "link_odom_robot_pose_viz",
          "type": "topic_link",
          "when": "${socrates_agent_id}",
          "on_failure": "continue",
          "operation": "create",
          "source_topic": "lucid/agents/${robot_id}/components/ros_bridge/telemetry/odom",
          "target_topic": "lucid/agents/${socrates_agent_id}/components/viz/telemetry/robot_pose_odom",
          "select_clause": "payload.value.pose.pose.position.x as px, payload.value.pose.pose.position.y as py, payload.value.pose.pose.orientation.x as ox, payload.value.pose.pose.orientation.y as oy, payload.value.pose.pose.orientation.z as oz, payload.value.pose.pose.orientation.w as ow",
          "payload_template": "{\"value\": {\"pose\": {\"position\": {\"x\": ${px}, \"y\": ${py}}, \"orientation\": {\"x\": ${ox}, \"y\": ${oy}, \"z\": ${oz}, \"w\": ${ow}}}}}",
          "qos": 0
        },
        {
          "name": "link_optitrack_robot_pose_viz",
          "type": "topic_link",
          "when": "${socrates_agent_id}",
          "on_failure": "continue",
          "operation": "create",
          "source_topic": "lucid/agents/${optitrack_agent_id}/components/ros_bridge/telemetry/natnet_ros_umh_6_pose",
          "target_topic": "lucid/agents/${socrates_agent_id}/components/viz/telemetry/robot_pose_optitrack",
          "select_clause": "payload.value.pose.position.x as px, payload.value.pose.position.y as py, payload.value.pose.position.z as pz, payload.value.pose.orientation.x as ox, payload.value.pose.orientation.y as oy, payload.value.pose.orientation.z as oz, payload.value.pose.orientation.w as ow",
          "payload_template": "{\"value\": {\"pose\": {\"position\": {\"x\": ${px}, \"y\": ${py}, \"z\": ${pz}}, \"orientation\": {\"x\": ${ox}, \"y\": ${oy}, \"z\": ${oz}, \"w\": ${ow}}}}}",
          "qos": 0
        },
        {
          "name": "link_perception_color_led",
          "type": "topic_link",
          "when": "${led_agent_id}",
          "on_failure": "continue",
          "operation": "create",
          "source_topic": "lucid/agents/${robot_id}/components/perception/evt/color_detected",
          "target_topic": "lucid/agents/${led_agent_id}/components/led_strip/cmd/set-color",
          "select_clause": "*",
          "payload_template": "{\"color\": {\"r\": ${payload.r}, \"g\": ${payload.g}, \"b\": ${payload.b}}}",
          "qos": 0
        },
        {
          "name": "link_puck_color_led",
          "type": "topic_link",
          "when": "${led_agent_id}",
          "on_failure": "continue",
          "operation": "create",
          "source_topic": "lucid/agents/${robot_id}/components/ros_bridge/telemetry/puck_confirmed",
          "target_topic": "lucid/agents/${led_agent_id}/components/led_strip/cmd/set-color",
          "select_clause": "CASE payload.value.color WHEN 1 THEN 255 ELSE 0 END as r, CASE payload.value.color WHEN 2 THEN 255 ELSE 0 END as g, CASE payload.value.color WHEN 3 THEN 255 ELSE 0 END as b",
          "payload_template": "{\"color\": {\"r\": ${r}, \"g\": ${g}, \"b\": ${b}}}",
          "qos": 0
        },
        {
          "name": "link_aruco_color_led",
          "type": "topic_link",
          "when": "${led_agent_id}",
          "on_failure": "continue",
          "operation": "create",
          "source_topic": "lucid/agents/${robot_id}/components/ros_bridge/telemetry/aruco_confirmed",
          "target_topic": "lucid/agents/${led_agent_id}/components/led_strip/cmd/set-color",
          "select_clause": "CASE payload.value.marker_id WHEN 1 THEN 255 ELSE 0 END as r, CASE payload.value.marker_id WHEN 2 THEN 255 ELSE 0 END as g, CASE payload.value.marker_id WHEN 3 THEN 255 ELSE 0 END as b",
          "payload_template": "{\"color\": {\"r\": ${r}, \"g\": ${g}, \"b\": ${b}}}",
          "qos": 0
        }
      ]
    }
  ]
}
