{
  "id": "foraging-run",
  "name": "Foraging Run",
  "version": "1.0.0",
  "description": "Restarts rosbot in rosserial mode, enables foraging telemetry, creates viz and LED topic links, starts recordings, and launches foraging.",
  "tags": ["foraging", "experiment"],
  "parameters": {
    "robot_id":                    { "type": "string",  "default": "rosbot",                     "required": true,  "description": "ROSbot agent ID" },
    "hydra_agent_id":              { "type": "string",  "default": "hydra",                      "required": true,  "description": "Hydra agent (OptiTrack)" },
    "optitrack_agent_id":          { "type": "string",  "default": "hydra",                      "required": false, "description": "OptiTrack recording agent" },
    "camera_agent_id":             { "type": "string",  "default": "camera",                     "required": false, "description": "Camera agent" },
    "socrates_agent_id":           { "type": "string",  "default": "socrates",                   "required": false, "description": "Viz agent" },
    "led_agent_id":                { "type": "string",  "default": "led_truss",                  "required": false, "description": "LED strip agent" },
    "launch_rosbot":               { "type": "boolean", "default": true,                         "required": false, "description": "Restart rosbot and enable telemetry" },
    "launch_hydra":                { "type": "boolean", "default": true,                         "required": false, "description": "Enable OptiTrack telemetry and link" },
    "launch_camera":               { "type": "boolean", "default": false,                        "required": false, "description": "Start camera recording" },
    "launch_socrates":             { "type": "boolean", "default": false,                        "required": false, "description": "Create viz topic links" },
    "launch_led":                  { "type": "boolean", "default": true,                         "required": false, "description": "Show LED transitions and reactive links" },
    "launch_scan":                 { "type": "boolean", "default": false,                        "required": false, "description": "Forward /scan lidar telemetry at 1 Hz; can also be toggled mid-run via scan-telemetry-toggle" },
    "robot_host":                  { "type": "string",  "default": "husarion@10.205.3.20",       "required": false, "description": "SSH target for ROSbot" },
    "compose_file":                { "type": "string",  "default": "compose_farah.yaml",         "required": false, "description": "Docker compose file on ROSbot" },
    "roslaunch_package":           { "type": "string",  "default": "foraging_bringup",           "required": false, "description": "ROS package for foraging" },
    "roslaunch_file":              { "type": "string",  "default": "foraging_experiment.launch",  "required": false, "description": "Launch file for foraging" },
    "rosbag_output_dir":           { "type": "string",  "default": "~/lucid-agent-core/data/bags",         "required": false, "description": "Rosbag dir on robot" },
    "optitrack_rosbag_output_dir": { "type": "string",  "default": "~/lucid-agent-core/data/bags",         "required": false, "description": "Rosbag dir on OptiTrack agent" },
    "camera_rosbag_output_dir":    { "type": "string",  "default": "~/lucid-agent-core-camera/data/bags",  "required": false, "description": "Rosbag dir on camera agent" },
    "bridge_settle_s":             { "type": "float",   "default": 5.0,                          "required": false, "description": "Seconds to wait after ros_bridge retry" },
    "explore_puck_pct":            { "type": "float",   "default": 0.5,                          "required": false, "description": "Fraction of explore time spent on pucks" },
    "explore_corner_pct":          { "type": "float",   "default": 0.4,                         "required": false, "description": "Fraction of explore time spent on corners" }
  },
  "steps": [
    {
      "name": "kill-old-rosbot-docker",
      "type": "command",
      "when": "${launch_rosbot}",
      "on_failure": "continue",
      "agent_id": "${robot_id}",
      "component_id": "exec",
      "action": "kill",
      "timeout_s": 15,
      "params": { "name": "rosbot_docker" }
    },
    {
      "name": "stop-remote-docker",
      "type": "command",
      "when": "${launch_rosbot}",
      "on_failure": "continue",
      "agent_id": "${robot_id}",
      "component_id": "exec",
      "action": "run",
      "timeout_s": 30,
      "params": { "command": "ssh -o BatchMode=yes -o StrictHostKeyChecking=no ${robot_host} 'docker compose -f ${compose_file} down'" }
    },
    {
      "name": "restart-rosbot-docker",
      "type": "command",
      "when": "${launch_rosbot}",
      "on_failure": "abort",
      "agent_id": "${robot_id}",
      "component_id": "exec",
      "action": "spawn",
      "timeout_s": 15,
      "retries": 1,
      "params": { "name": "rosbot_docker", "command": "ssh -o BatchMode=yes -o StrictHostKeyChecking=no ${robot_host} 'docker compose -f ${compose_file} up'" }
    },

    {
      "name": "wait-for-docker-startup",
      "type": "delay",
      "when": "${launch_rosbot}",
      "on_failure": "abort",
      "duration_s": 15.0
    },

    {
      "name": "kill-old-rosserial",
      "type": "command",
      "when": "${launch_rosbot}",
      "on_failure": "continue",
      "agent_id": "${robot_id}",
      "component_id": "exec",
      "action": "kill",
      "timeout_s": 15,
      "params": { "name": "rosserial" }
    },
    {
      "name": "start-rosserial",
      "type": "command",
      "when": "${launch_rosbot}",
      "on_failure": "abort",
      "agent_id": "${robot_id}",
      "component_id": "exec",
      "action": "spawn",
      "timeout_s": 15,
      "params": { "name": "rosserial", "command": "ssh -o BatchMode=yes -o StrictHostKeyChecking=no ${robot_host} 'source /opt/ros/noetic/setup.bash && source /home/husarion/husarion_ws/devel/setup.bash && port=$(readlink -f /dev/serial/by-id/usb-1a86_USB_Serial-if00-port0) && rosrun rosserial_python serial_node.py $port'" }
    },

    {
      "name": "wait-for-rosserial",
      "type": "delay",
      "when": "${launch_rosbot}",
      "on_failure": "abort",
      "duration_s": 5.0
    },

    {
      "name": "stop-rosbot-ros-bridge",
      "type": "command",
      "when": "${launch_rosbot}",
      "on_failure": "continue",
      "agent_id": "${robot_id}",
      "component_id": "ros_bridge",
      "action": "stop-ros",
      "timeout_s": 30,
      "params": {}
    },

    {
      "name": "start-rosbot-ros-bridge",
      "type": "command",
      "when": "${launch_rosbot}",
      "on_failure": "abort",
      "agent_id": "${robot_id}",
      "component_id": "ros_bridge",
      "action": "start-ros",
      "timeout_s": 30,
      "params": {}
    },

    {
      "name": "wait-for-ros-bridge",
      "type": "delay",
      "when": "${launch_rosbot}",
      "on_failure": "abort",
      "duration_s": "${bridge_settle_s}"
    },

    {
      "name": "enable-foraging-telemetry",
      "type": "parallel",
      "on_failure": "abort",
      "steps": [
        { "name": "enable-optitrack-telemetry",         "type": "command", "when": "${launch_hydra}",  "on_failure": "abort", "agent_id": "${hydra_agent_id}", "component_id": "ros_bridge", "action": "cfg/telemetry/set", "timeout_s": 10, "params": { "set": { "optitrack_umh_6": { "enabled": true, "interval_s": 1.0, "change_threshold_percent": 0.0 } } } },
        { "name": "enable-rosbot-foraging-telemetry",   "type": "command", "when": "${launch_rosbot}", "on_failure": "abort", "agent_id": "${robot_id}",       "component_id": "ros_bridge", "action": "cfg/telemetry/set", "timeout_s": 10, "params": { "set": { "puck_registry": { "enabled": true, "interval_s": 1.0, "change_threshold_percent": 0.0 }, "aruco_registry": { "enabled": true, "interval_s": 1.0, "change_threshold_percent": 0.0 }, "odom": { "enabled": true, "interval_s": 1.0, "change_threshold_percent": 0.0 }, "foraging_status": { "enabled": true, "interval_s": 1.0, "change_threshold_percent": 0.0 } } } },
        { "name": "enable-scan-telemetry",              "type": "command", "when": "${launch_scan}",   "on_failure": "abort", "agent_id": "${robot_id}",       "component_id": "ros_bridge", "action": "cfg/telemetry/set", "timeout_s": 10, "params": { "set": { "scan": { "enabled": true, "interval_s": 1.0, "change_threshold_percent": 0.0 } } } }
      ]
    },

    {
      "name": "create-foraging-topic-links",
      "type": "parallel",
      "on_failure": "abort",
      "steps": [
        { "name": "link-puck-registry-to-viz",     "type": "topic_link", "when": "${launch_socrates}", "on_failure": "continue", "operation": "create", "source_topic": "lucid/agents/${robot_id}/components/ros_bridge/telemetry/puck_registry", "target_topic": "lucid/agents/${socrates_agent_id}/components/viz/cmd/puck_registry", "select_clause": "payload.value as value, id as request_id", "payload_template": "{\"request_id\": \"${request_id}\", \"value\": ${value}}", "qos": 0 },
        { "name": "link-aruco-registry-to-viz",    "type": "topic_link", "when": "${launch_socrates}", "on_failure": "continue", "operation": "create", "source_topic": "lucid/agents/${robot_id}/components/ros_bridge/telemetry/aruco_registry", "target_topic": "lucid/agents/${socrates_agent_id}/components/viz/cmd/aruco_registry", "select_clause": "payload.value as value, id as request_id", "payload_template": "{\"request_id\": \"${request_id}\", \"value\": ${value}}", "qos": 0 },
        { "name": "link-odom-to-viz",              "type": "topic_link", "when": "${launch_socrates}", "on_failure": "continue", "operation": "create", "source_topic": "lucid/agents/${robot_id}/components/ros_bridge/telemetry/odom", "target_topic": "lucid/agents/${socrates_agent_id}/components/viz/cmd/robot_pose_odom", "select_clause": "payload.value.pose.pose.position.x as px, payload.value.pose.pose.position.y as py, payload.value.pose.pose.orientation.x as ox, payload.value.pose.pose.orientation.y as oy, payload.value.pose.pose.orientation.z as oz, payload.value.pose.pose.orientation.w as ow, id as request_id", "payload_template": "{\"request_id\": \"${request_id}\", \"value\": {\"pose\": {\"position\": {\"x\": ${px}, \"y\": ${py}}, \"orientation\": {\"x\": ${ox}, \"y\": ${oy}, \"z\": ${oz}, \"w\": ${ow}}}}}", "qos": 0 },
        { "name": "link-optitrack-pose-to-viz",    "type": "topic_link", "when": "${launch_socrates}", "on_failure": "continue", "operation": "create", "source_topic": "lucid/agents/${optitrack_agent_id}/components/ros_bridge/telemetry/optitrack_umh_6", "target_topic": "lucid/agents/${socrates_agent_id}/components/viz/cmd/robot_pose_optitrack", "select_clause": "payload.value.pose.position.x as px, payload.value.pose.position.y as py, payload.value.pose.position.z as pz, payload.value.pose.orientation.x as ox, payload.value.pose.orientation.y as oy, payload.value.pose.orientation.z as oz, payload.value.pose.orientation.w as ow, id as request_id", "payload_template": "{\"request_id\": \"${request_id}\", \"value\": {\"pose\": {\"position\": {\"x\": ${px}, \"y\": ${py}, \"z\": ${pz}}, \"orientation\": {\"x\": ${ox}, \"y\": ${oy}, \"z\": ${oz}, \"w\": ${ow}}}}}", "qos": 0 },
        { "name": "link-foraging-mode-to-led",     "type": "topic_link", "when": "${launch_led}",      "on_failure": "continue", "operation": "create", "source_topic": "lucid/agents/${robot_id}/components/ros_bridge/telemetry/foraging_status", "target_topic": "lucid/agents/${led_agent_id}/components/led_strip/cmd/set-color", "select_clause": "CASE payload.value.mode WHEN 0 THEN 0 WHEN 1 THEN 255 WHEN 2 THEN 0 ELSE 255 END as r, CASE payload.value.mode WHEN 0 THEN 0 WHEN 1 THEN 255 WHEN 2 THEN 255 ELSE 0 END as g, CASE payload.value.mode WHEN 0 THEN 255 WHEN 1 THEN 0 WHEN 2 THEN 0 ELSE 0 END as b, id as request_id", "payload_template": "{\"request_id\": \"${request_id}\", \"color\": {\"r\": ${r}, \"g\": ${g}, \"b\": ${b}}}", "qos": 0 },
        { "name": "link-scan-to-viz",              "type": "topic_link", "when": "${launch_socrates}", "on_failure": "continue", "operation": "create", "source_topic": "lucid/agents/${robot_id}/components/ros_bridge/telemetry/scan", "target_topic": "lucid/agents/${socrates_agent_id}/components/viz/cmd/scan", "select_clause": "payload.value as value, id as request_id", "payload_template": "{\"request_id\": \"${request_id}\", \"value\": ${value}}", "qos": 0 }
      ]
    },

    {
      "name": "start-foraging-recordings",
      "type": "parallel",
      "on_failure": "continue",
      "steps": [
        { "name": "start-rosbot-foraging-rosbag",    "type": "command", "when": "${launch_rosbot}", "on_failure": "continue", "agent_id": "${robot_id}",           "component_id": "ros_bridge", "action": "rosbag-start", "timeout_s": 15, "params": { "data": { "output_dir": "${rosbag_output_dir}",           "prefix": "foraging" } } },
        { "name": "start-optitrack-foraging-rosbag",  "type": "command", "when": "${launch_hydra}",  "on_failure": "continue", "agent_id": "${optitrack_agent_id}", "component_id": "ros_bridge", "action": "rosbag-start", "timeout_s": 15, "params": { "data": { "output_dir": "${optitrack_rosbag_output_dir}", "prefix": "foraging" } } },
        { "name": "start-camera-recording",           "type": "command", "when": "${launch_camera}", "on_failure": "continue", "agent_id": "${camera_agent_id}",    "component_id": "ros_bridge", "action": "rosbag-start", "timeout_s": 15, "params": { "data": { "output_dir": "${camera_rosbag_output_dir}",    "prefix": "foraging" } } }
      ]
    },

    {
      "name": "start-foraging",
      "type": "command",
      "on_failure": "abort",
      "agent_id": "${robot_id}",
      "component_id": "ros_bridge",
      "action": "roslaunch-start",
      "timeout_s": 30,
      "params": { "data": { "package": "${roslaunch_package}", "launch_file": "${roslaunch_file}", "args": { "num_pucks": "3", "step_size": "0.5", "walk_sigma": "0.5", "max_vel_x": "0.2", "explore_puck_pct": "${explore_puck_pct}", "explore_corner_pct": "${explore_corner_pct}", "open_rviz": "false" } } }
    },

    {
      "name": "wait-for-foraging-complete",
      "type": "wait_for_condition",
      "on_failure": "abort",
      "agent_id": "${robot_id}",
      "component_id": "ros_bridge",
      "telemetry_metric": "foraging_status",
      "condition": { "field": "value.state", "in": ["completed", "error"] },
      "timeout_s": 1800,
      "on_timeout": "continue"
    },

    { "name": "led-foraging-complete", "type": "command", "when": "${launch_led}", "on_failure": "continue", "agent_id": "${led_agent_id}", "component_id": "led_strip", "action": "effect/rainbow", "timeout_s": 10, "params": {} },

    {
      "name": "stop-foraging-recordings",
      "type": "parallel",
      "on_failure": "continue",
      "steps": [
        { "name": "stop-rosbot-foraging-rosbag",   "type": "command", "when": "${launch_rosbot}", "on_failure": "continue", "agent_id": "${robot_id}",           "component_id": "ros_bridge", "action": "rosbag-stop", "timeout_s": 15, "params": {} },
        { "name": "stop-optitrack-foraging-rosbag", "type": "command", "when": "${launch_hydra}",  "on_failure": "continue", "agent_id": "${optitrack_agent_id}", "component_id": "ros_bridge", "action": "rosbag-stop", "timeout_s": 15, "params": {} },
        { "name": "stop-camera-recording",          "type": "command", "when": "${launch_camera}", "on_failure": "continue", "agent_id": "${camera_agent_id}",    "component_id": "ros_bridge", "action": "rosbag-stop", "timeout_s": 15, "params": {} }
      ]
    }
  ]
}
