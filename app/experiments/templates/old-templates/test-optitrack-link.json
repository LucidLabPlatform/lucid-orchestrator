{
  "id": "test-optitrack-link",
  "name": "Test OptiTrack → ROSbot Link",
  "version": "1.0.0",
  "description": "Sets up the OptiTrack-to-ROSbot topic link so you can verify pose data flows correctly. Does NOT navigate the robot. Run the test script (scripts/test_optitrack_link.py) alongside this to see live pose data.",
  "tags": [
    "test",
    "optitrack",
    "rosbot"
  ],
  "parameters": {
    "rosbot_agent_id": {
      "type": "string",
      "default": "rosbot",
      "description": "Agent ID for the ROSbot",
      "required": true
    },
    "hydra_agent_id": {
      "type": "string",
      "default": "hydra",
      "description": "Agent ID for the Hydra node (hosts OptiTrack ROS bridge)",
      "required": true
    },
    "observe_duration_s": {
      "type": "float",
      "default": "120",
      "description": "How long to keep the link active for observation (seconds)",
      "required": false
    }
  },
  "steps": [
    {
      "name": "preflight_ping",
      "type": "parallel",
      "on_failure": "abort",
      "retries": 0,
      "steps": [
        {
          "name": "ping_rosbot",
          "type": "command",
          "on_failure": "abort",
          "retries": 0,
          "agent_id": "${rosbot_agent_id}",
          "action": "ping",
          "timeout_s": "10",
          "params": {}
        },
        {
          "name": "ping_hydra",
          "type": "command",
          "on_failure": "abort",
          "retries": 0,
          "agent_id": "${hydra_agent_id}",
          "action": "ping",
          "timeout_s": "10",
          "params": {}
        }
      ]
    },
    {
      "name": "start_roscore_hydra",
      "type": "command",
      "on_failure": "continue",
      "retries": 0,
      "agent_id": "${hydra_agent_id}",
      "component_id": "exec",
      "action": "spawn",
      "timeout_s": "15",
      "params": {
        "name": "roscore",
        "command": "source /opt/ros/noetic/setup.bash && roscore"
      }
    },
    {
      "name": "start_optitrack",
      "type": "command",
      "on_failure": "abort",
      "retries": 1,
      "agent_id": "${hydra_agent_id}",
      "component_id": "ros_bridge",
      "action": "roslaunch_start",
      "timeout_s": "30",
      "params": {
        "data": {
          "package": "optitrack_ros_communication",
          "launch_file": "optitrack_nodes.launch",
          "args": {
            "serverIP": "10.205.3.3",
            "namespace": "natnet_ros",
            "clientIP": "10.205.10.254",
            "serverType": "unicast"
          }
        }
      }
    },
    {
      "name": "link_optitrack_to_rosbot",
      "type": "topic_link",
      "on_failure": "abort",
      "retries": 0,
      "operation": "create",
      "source_topic": "lucid/agents/${hydra_agent_id}/components/ros_bridge/telemetry/optitrack_umh_5",
      "target_topic": "lucid/agents/${rosbot_agent_id}/components/ros_bridge/cmd/optitrack_pose",
      "select_clause": "payload.value as value",
      "payload_template": "{\"request_id\": \"auto\", \"data\": ${value}}",
      "qos": 0
    },
    {
      "name": "observe",
      "type": "delay",
      "on_failure": "abort",
      "retries": 0,
      "duration_s": "${observe_duration_s}"
    }
  ]
}
