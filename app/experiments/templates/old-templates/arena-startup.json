{
  "id": "arena-startup",
  "name": "Arena Startup",
  "version": "1.1.0",
  "description": "Full arena bringup: pings all agents, powers on projectors with NDI streams, launches TouchDesigner and Arena overlay, and signals ready on the LED strip.",
  "tags": ["foraging", "setup"],
  "parameters": {
    "north_agent_id":   { "type": "string",  "default": "north",                          "required": true,  "description": "Agent ID for the north projector node" },
    "east_agent_id":    { "type": "string",  "default": "east",                           "required": true,  "description": "Agent ID for the east projector node" },
    "west_agent_id":    { "type": "string",  "default": "west",                           "required": true,  "description": "Agent ID for the west projector node" },
    "hydra_agent_id":   { "type": "string",  "default": "hydra",                          "required": true,  "description": "Agent ID for the Hydra node (KNX lights)" },
    "rosbot_agent_id":  { "type": "string",  "default": "rosbot",                         "required": false, "description": "Agent ID for the ROSbot" },
    "socrates_agent_id":{ "type": "string",  "default": "socrates",                       "required": true,  "description": "Agent ID running the viz component" },
    "led_agent_id":     { "type": "string",  "default": "led_truss",                      "required": true,  "description": "Agent ID hosting the LED strip component" },
    "camera_agent_id":  { "type": "string",  "default": "camera",                         "required": false, "description": "Agent ID hosting the camera component" },
    "ndi_source_north": { "type": "string",  "default": "ROBOTICSS-MAC-PRO.LOCAL (north)","required": false, "description": "NDI source name for the north projector" },
    "ndi_source_east":  { "type": "string",  "default": "ROBOTICSS-MAC-PRO.LOCAL (east)", "required": false, "description": "NDI source name for the east projector" },
    "ndi_source_west":  { "type": "string",  "default": "ROBOTICSS-MAC-PRO.LOCAL (west)", "required": false, "description": "NDI source name for the west projector" },
    "room_brightness":  { "type": "integer", "default": 1,                                "required": false, "description": "Room light brightness 0-100" },
    "ping_timeout_s":        { "type": "float",   "default": 10.0, "required": false, "description": "Seconds to wait for each preflight ping" },
    "projector_warmup_s":    { "type": "float",   "default": 0.0,  "required": false, "description": "Seconds to wait after powering on projectors before starting NDI (0 = no delay)" },
    "arena_anchor_corner":   { "type": "string", "default": "TR",                  "required": false, "description": "Which arena corner is anchored in OptiTrack (TL/TR/BR/BL)" },
    "arena_anchor_x":        { "type": "float",  "default": -0.03,                 "required": false, "description": "Anchor corner X in OptiTrack frame" },
    "arena_anchor_y":        { "type": "float",  "default": 0.10,                  "required": false, "description": "Anchor corner Y in OptiTrack frame" },
    "goal_x":                { "type": "float",  "default": 1.8313400745391846,     "required": false, "description": "Robot start X (OptiTrack frame)" },
    "goal_y":                { "type": "float",  "default": 1.9327030181884766,     "required": false, "description": "Robot start Y (OptiTrack frame)" },
    "goal_qx":               { "type": "float",  "default": 0.06450924277305603,  "required": false, "description": "Robot start orientation qx" },
    "goal_qy":               { "type": "float",  "default": 0.0404166504740715, "required": false, "description": "Robot start orientation qy" },
    "goal_qz":               { "type": "float",  "default": -0.9158637523651123,   "required": false, "description": "Robot start orientation qz" },
    "goal_qw":               { "type": "float",  "default": 0.3942064046859741,    "required": false, "description": "Robot start orientation qw" }
  },
  "steps": [
    {
      "name": "led_startup_working",
      "type": "command",
      "on_failure": "continue",
      "retries": 0,
      "agent_id": "${led_agent_id}",
      "component_id": "led_strip",
      "action": "effect/glow",
      "timeout_s": 10,
      "params": { "color": { "r": 255, "g": 150, "b": 0 }, "wait_ms": 25 }
    },
    {
      "name": "preflight_ping",
      "type": "template",
      "on_failure": "abort",
      "template_id": "ping-agents",
      "template_params": {
        "north_agent_id":    "${north_agent_id}",
        "east_agent_id":     "${east_agent_id}",
        "west_agent_id":     "${west_agent_id}",
        "hydra_agent_id":    "${hydra_agent_id}",
        "rosbot_agent_id":   "${rosbot_agent_id}",
        "socrates_agent_id": "${socrates_agent_id}",
        "led_agent_id":      "${led_agent_id}",
        "camera_agent_id":   "${camera_agent_id}",
        "timeout_s":         "${ping_timeout_s}"
      }
    },
    {
      "name": "run_projector_ndi",
      "type": "template",
      "on_failure": "abort",
      "template_id": "projector-ndi-connect",
      "template_params": {
        "north_agent_id":   "${north_agent_id}",
        "east_agent_id":    "${east_agent_id}",
        "west_agent_id":    "${west_agent_id}",
        "ndi_source_north": "${ndi_source_north}",
        "ndi_source_east":  "${ndi_source_east}",
        "ndi_source_west":  "${ndi_source_west}",
        "projector_warmup_s": "${projector_warmup_s}"
      }
    },
    {
      "name": "run_arena_td",
      "type": "template",
      "on_failure": "abort",
      "template_id": "arena-td-launch",
      "template_params": {
        "socrates_agent_id":   "${socrates_agent_id}",
        "hydra_agent_id":      "${hydra_agent_id}",
        "room_brightness":     "${room_brightness}",
        "arena_anchor_corner": "${arena_anchor_corner}",
        "arena_anchor_x":      "${arena_anchor_x}",
        "arena_anchor_y":      "${arena_anchor_y}",
        "goal_x":  "${goal_x}",
        "goal_y":  "${goal_y}",
        "goal_qx": "${goal_qx}",
        "goal_qy": "${goal_qy}",
        "goal_qz": "${goal_qz}",
        "goal_qw": "${goal_qw}"
      }
    }
  ]
}
