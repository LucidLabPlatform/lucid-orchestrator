{
  "id": "test-optitrack-pipeline",
  "name": "Test OptiTrack \u2192 ROSbot Pipeline",
  "version": "1.0.2",
  "description": "Verifies that OptiTrack data flows from hydra to rosbot. Starts roscore, launches optitrack nodes, enables umh_5 telemetry, and creates the topic link. Use mosquitto_sub to confirm rosbot receives optitrack_pose commands.",
  "tags": [
    "test",
    "optitrack",
    "rosbot"
  ],
  "parameters": {
    "hydra_agent_id": {
      "type": "string",
      "default": "hydra",
      "required": true,
      "description": "Agent ID for Hydra (OptiTrack host)"
    },
    "rosbot_agent_id": {
      "type": "string",
      "default": "rosbot",
      "required": true,
      "description": "Agent ID for the ROSbot"
    }
  },
  "steps": [
    {
      "name": "start_roscore",
      "type": "command",
      "on_failure": "continue",
      "retries": 0,
      "agent_id": "${hydra_agent_id}",
      "component_id": "exec",
      "action": "spawn",
      "timeout_s": 15,
      "params": {
        "name": "roscore",
        "command": "source /opt/ros/noetic/setup.bash && roscore"
      }
    },
    {
      "name": "roscore_settle",
      "type": "delay",
      "on_failure": "abort",
      "duration_s": 3
    },
    {
      "name": "start_optitrack",
      "type": "command",
      "on_failure": "abort",
      "retries": 1,
      "agent_id": "${hydra_agent_id}",
      "component_id": "ros_bridge",
      "action": "roslaunch-start",
      "timeout_s": 30,
      "params": {
        "data": {
          "package": "optitrack_ros_communication",
          "launch_file": "optitrack_nodes.launch",
          "args": {
            "serverIP": "10.205.3.3",
            "namespace": "natnet_ros",
            "clientIP": "10.205.10.254",
            "serverType": "unicast"
          }
        }
      }
    },
    {
      "name": "enable_optitrack_telemetry",
      "type": "command",
      "on_failure": "continue",
      "retries": 0,
      "agent_id": "${hydra_agent_id}",
      "component_id": "ros_bridge",
      "action": "cfg/telemetry/set",
      "timeout_s": 10,
      "params": {
        "set": {
          "optitrack_umh_5": {
            "enabled": true,
            "interval_s": 0.1
          }
        }
      }
    },
    {
      "name": "link_optitrack_to_rosbot",
      "type": "topic_link",
      "on_failure": "abort",
      "retries": 0,
      "operation": "create",
      "source_topic": "lucid/agents/${hydra_agent_id}/components/ros_bridge/telemetry/optitrack_umh_5",
      "target_topic": "lucid/agents/${rosbot_agent_id}/components/ros_bridge/cmd/optitrack_pose",
      "select_clause": "payload.value as value",
      "payload_template": "{\"data\": ${value}}",
      "qos": 0
    }
  ]
}