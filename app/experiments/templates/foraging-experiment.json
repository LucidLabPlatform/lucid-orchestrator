{
  "id": "foraging-experiment",
  "name": "Foraging Experiment",
  "version": "3.0.0",
  "description": "Full foraging experiment: setup → reset → puck approval → foraging run → teardowns. Toggle agents with launch_* booleans.",
  "tags": ["foraging", "experiment"],
  "parameters": {
    "robot_id":                    { "type": "string",  "default": "rosbot",                          "required": true,  "description": "ROSbot agent ID" },
    "hydra_agent_id":              { "type": "string",  "default": "hydra",                           "required": true,  "description": "Hydra agent (OptiTrack, chrony)" },
    "optitrack_agent_id":          { "type": "string",  "default": "hydra",                           "required": false, "description": "OptiTrack recording agent" },
    "camera_agent_id":             { "type": "string",  "default": "camera",                          "required": false, "description": "Camera agent" },
    "socrates_agent_id":           { "type": "string",  "default": "socrates",                        "required": false, "description": "Viz agent" },
    "led_agent_id":                { "type": "string",  "default": "led_truss",                       "required": false, "description": "LED strip agent" },
    "launch_arena":                { "type": "boolean", "default": true,                              "required": false, "description": "Run arena startup" },
    "launch_rosbot":               { "type": "boolean", "default": true,                              "required": false, "description": "Start rosbot docker and ros_bridge" },
    "launch_hydra":                { "type": "boolean", "default": true,                              "required": false, "description": "Start hydra roscore, ros_bridge, OptiTrack" },
    "launch_camera":               { "type": "boolean", "default": false,                             "required": false, "description": "Start camera roscore, ros_bridge, camera" },
    "launch_socrates":             { "type": "boolean", "default": false,                             "required": false, "description": "Create viz topic links" },
    "launch_led":                  { "type": "boolean", "default": true,                              "required": false, "description": "Show LED transitions" },
    "robot_host":                  { "type": "string",  "default": "husarion@10.205.3.20",            "required": false, "description": "SSH target for ROSbot" },
    "compose_file":                { "type": "string",  "default": "compose_farah.yaml",              "required": false, "description": "Docker compose file on ROSbot" },
    "goal_x":                      { "type": "float",   "default": 2.992316246032715,                 "required": false, "description": "Start X (OptiTrack frame)" },
    "goal_y":                      { "type": "float",   "default": 1.827694296836853,                 "required": false, "description": "Start Y (OptiTrack frame)" },
    "goal_qx":                     { "type": "float",   "default": -0.00494308490306139,              "required": false, "description": "Start orientation quaternion X" },
    "goal_qy":                     { "type": "float",   "default": -0.011712746694684029,             "required": false, "description": "Start orientation quaternion Y" },
    "goal_qz":                     { "type": "float",   "default": -0.9295409917831421,               "required": false, "description": "Start orientation quaternion Z" },
    "goal_qw":                     { "type": "float",   "default": 0.3684997856616974,                "required": false, "description": "Start orientation quaternion W" },
    "pos_tolerance":               { "type": "float",   "default": 0.10,                              "required": false, "description": "Position tolerance (metres)" },
    "yaw_tolerance":               { "type": "float",   "default": 0.15,                              "required": false, "description": "Yaw tolerance (radians)" },
    "rosbag_output_dir":           { "type": "string",  "default": "~/lucid-agent-core/data/bags",         "required": false, "description": "Rosbag dir on robot and OptiTrack" },
    "optitrack_rosbag_output_dir": { "type": "string",  "default": "~/lucid-agent-core/data/bags",         "required": false, "description": "Rosbag dir on OptiTrack agent" },
    "camera_rosbag_output_dir":    { "type": "string",  "default": "~/lucid-agent-core-camera/data/bags",  "required": false, "description": "Rosbag dir on camera agent" },
    "roslaunch_package":           { "type": "string",  "default": "foraging_bringup",                "required": false, "description": "ROS package for foraging" },
    "roslaunch_file":              { "type": "string",  "default": "foraging_experiment.launch",      "required": false, "description": "Launch file for foraging" },
    "run_setup":                   { "type": "boolean", "default": true,                              "required": false, "description": "Run setup phase" },
    "run_reset":                   { "type": "boolean", "default": true,                              "required": false, "description": "Run reset-to-start phase" },
    "run_puck_approval":           { "type": "boolean", "default": true,                              "required": false, "description": "Run puck placement approval" },
    "run_foraging":                { "type": "boolean", "default": true,                              "required": false, "description": "Run foraging phase" },
    "run_teardown":                { "type": "boolean", "default": true,                              "required": false, "description": "Run teardown phases" }
  },
  "steps": [
    {
      "name": "foraging-setup",
      "type": "template",
      "when": "${run_setup}",
      "on_failure": "abort",
      "template_id": "foraging-setup",
      "template_params": {
        "robot_id": "${robot_id}",
        "hydra_agent_id": "${hydra_agent_id}",
        "camera_agent_id": "${camera_agent_id}",
        "led_agent_id": "${led_agent_id}",
        "socrates_agent_id": "${socrates_agent_id}",
        "launch_arena": "${launch_arena}",
        "launch_rosbot": "${launch_rosbot}",
        "launch_hydra": "${launch_hydra}",
        "launch_camera": "${launch_camera}",
        "launch_led": "${launch_led}",
        "robot_host": "${robot_host}",
        "compose_file": "${compose_file}"
      }
    },

    {
      "name": "foraging-reset",
      "type": "template",
      "when": "${run_reset}",
      "on_failure": "abort",
      "template_id": "foraging-reset",
      "template_params": {
        "robot_id": "${robot_id}",
        "hydra_agent_id": "${hydra_agent_id}",
        "optitrack_agent_id": "${optitrack_agent_id}",
        "led_agent_id": "${led_agent_id}",
        "launch_rosbot": "${launch_rosbot}",
        "launch_hydra": "${launch_hydra}",
        "launch_camera": "${launch_camera}",
        "camera_agent_id": "${camera_agent_id}",
        "camera_rosbag_output_dir": "${camera_rosbag_output_dir}",
        "launch_led": "${launch_led}",
        "goal_x": "${goal_x}",
        "goal_y": "${goal_y}",
        "goal_qx": "${goal_qx}",
        "goal_qy": "${goal_qy}",
        "goal_qz": "${goal_qz}",
        "goal_qw": "${goal_qw}",
        "pos_tolerance": "${pos_tolerance}",
        "yaw_tolerance": "${yaw_tolerance}",
        "rosbag_output_dir": "${rosbag_output_dir}",
        "optitrack_rosbag_output_dir": "${optitrack_rosbag_output_dir}"
      }
    },

    {
      "name": "foraging-puck-approval",
      "type": "template",
      "when": "${run_puck_approval}",
      "on_failure": "abort",
      "template_id": "foraging-puck-approval",
      "template_params": {
        "led_agent_id": "${led_agent_id}",
        "launch_led": "${launch_led}"
      }
    },

    {
      "name": "foraging-run",
      "type": "template",
      "when": "${run_foraging}",
      "on_failure": "abort",
      "template_id": "foraging-run",
      "template_params": {
        "robot_id": "${robot_id}",
        "hydra_agent_id": "${hydra_agent_id}",
        "optitrack_agent_id": "${optitrack_agent_id}",
        "camera_agent_id": "${camera_agent_id}",
        "socrates_agent_id": "${socrates_agent_id}",
        "led_agent_id": "${led_agent_id}",
        "launch_rosbot": "${launch_rosbot}",
        "launch_hydra": "${launch_hydra}",
        "launch_camera": "${launch_camera}",
        "launch_socrates": "${launch_socrates}",
        "launch_led": "${launch_led}",
        "robot_host": "${robot_host}",
        "compose_file": "${compose_file}",
        "roslaunch_package": "${roslaunch_package}",
        "roslaunch_file": "${roslaunch_file}",
        "rosbag_output_dir": "${rosbag_output_dir}",
        "optitrack_rosbag_output_dir": "${optitrack_rosbag_output_dir}",
        "camera_rosbag_output_dir": "${camera_rosbag_output_dir}"
      }
    },

    {
      "name": "foraging-run-teardown",
      "type": "template",
      "when": "${run_teardown}",
      "on_failure": "continue",
      "template_id": "foraging-run-teardown",
      "template_params": {
        "robot_id": "${robot_id}",
        "hydra_agent_id": "${hydra_agent_id}",
        "led_agent_id": "${led_agent_id}",
        "launch_rosbot": "${launch_rosbot}",
        "launch_hydra": "${launch_hydra}",
        "launch_led": "${launch_led}"
      }
    },

    {
      "name": "foraging-reset-teardown",
      "type": "template",
      "when": "${run_teardown}",
      "on_failure": "continue",
      "template_id": "foraging-reset-teardown",
      "template_params": {
        "robot_id": "${robot_id}",
        "hydra_agent_id": "${hydra_agent_id}",
        "led_agent_id": "${led_agent_id}",
        "launch_rosbot": "${launch_rosbot}",
        "launch_hydra": "${launch_hydra}",
        "launch_led": "${launch_led}"
      }
    },

    {
      "name": "foraging-setup-teardown",
      "type": "template",
      "when": "${run_teardown}",
      "on_failure": "continue",
      "template_id": "foraging-setup-teardown",
      "template_params": {
        "robot_id": "${robot_id}",
        "hydra_agent_id": "${hydra_agent_id}",
        "camera_agent_id": "${camera_agent_id}",
        "robot_host": "${robot_host}",
        "compose_file": "${compose_file}",
        "launch_rosbot": "${launch_rosbot}",
        "launch_hydra": "${launch_hydra}",
        "launch_camera": "${launch_camera}"
      }
    }
  ]
}
