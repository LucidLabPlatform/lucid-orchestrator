{
  "id": "foraging-run-teardown",
  "name": "Foraging Run Teardown",
  "version": "1.0.0",
  "description": "Disables foraging-phase telemetry. Topic links are auto-deleted.",
  "tags": ["foraging", "teardown"],
  "parameters": {
    "robot_id":       { "type": "string",  "default": "rosbot", "required": true,  "description": "ROSbot agent ID" },
    "hydra_agent_id": { "type": "string",  "default": "hydra",  "required": true,  "description": "Hydra agent" },
    "launch_rosbot":  { "type": "boolean", "default": true,     "required": false, "description": "Disable rosbot foraging telemetry" },
    "launch_hydra":   { "type": "boolean", "default": true,     "required": false, "description": "Disable hydra OptiTrack telemetry" }
  },
  "steps": [
    {
      "name": "disable-foraging-telemetry",
      "type": "parallel",
      "on_failure": "continue",
      "steps": [
        { "name": "disable-optitrack-telemetry",         "type": "command", "when": "${launch_hydra}",  "on_failure": "continue", "agent_id": "${hydra_agent_id}", "component_id": "ros_bridge", "action": "cfg/telemetry/set", "timeout_s": 10, "params": { "set": { "optitrack_umh_5": { "enabled": false }, "natnet_ros_umh_6_pose": { "enabled": false } } } },
        { "name": "disable-rosbot-foraging-telemetry",   "type": "command", "when": "${launch_rosbot}", "on_failure": "continue", "agent_id": "${robot_id}",       "component_id": "ros_bridge", "action": "cfg/telemetry/set", "timeout_s": 10, "params": { "set": { "puck_registry": { "enabled": false }, "aruco_confirmed": { "enabled": false }, "odom": { "enabled": false }, "puck_confirmed": { "enabled": false }, "foraging_status": { "enabled": false } } } }
      ]
    }
  ]
}
