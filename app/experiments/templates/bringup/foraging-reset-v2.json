{
  "id": "foraging-reset-v2",
  "name": "Foraging Reset (v2)",
  "version": "1.0.0",
  "description": "Targets the renamed rosbot-pc agent. Enables OptiTrack + reset_status telemetry, creates pose and LED progress links, records reset rosbags, runs reset-to-start, waits for success (60s timeout), then stops recordings and tears down all links + telemetry it created.",
  "tags": [
    "bringup",
    "foraging",
    "reset"
  ],
  "parameters": {
    "rosbot_pc_agent_id": {
      "type": "string",
      "default": "rosbot_pc",
      "required": false,
      "description": "Agent running ros_bridge for the rosbot ROS master"
    },
    "hydra_agent_id": {
      "type": "string",
      "default": "hydra",
      "required": false,
      "description": "Hydra agent (OptiTrack)"
    },
    "optitrack_agent_id": {
      "type": "string",
      "default": "hydra",
      "required": false,
      "description": "Agent that records the OptiTrack rosbag (usually hydra)"
    },
    "camera_agent_id": {
      "type": "string",
      "default": "camera",
      "required": false,
      "description": "Camera agent"
    },
    "led_agent_id": {
      "type": "string",
      "default": "led_truss",
      "required": false,
      "description": "LED truss agent"
    },
    "launch_rosbot": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Enable rosbot-pc telemetry, recording, and reset roslaunch"
    },
    "launch_hydra": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Enable OptiTrack telemetry, topic link, and rosbag"
    },
    "launch_camera": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Record the camera rosbag during reset"
    },
    "launch_led": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Drive the LED progress bar from reset_status"
    },
    "goal_x": {
      "type": "float",
      "default": 1.8313400745391846,
      "required": false,
      "description": "Reset goal X (OptiTrack frame)"
    },
    "goal_y": {
      "type": "float",
      "default": 1.9327030181884766,
      "required": false,
      "description": "Reset goal Y (OptiTrack frame)"
    },
    "goal_qx": {
      "type": "float",
      "default": 0.06450924277305603,
      "required": false,
      "description": "Goal orientation quaternion X"
    },
    "goal_qy": {
      "type": "float",
      "default": 0.0404166504740715,
      "required": false,
      "description": "Goal orientation quaternion Y"
    },
    "goal_qz": {
      "type": "float",
      "default": -0.9158637523651123,
      "required": false,
      "description": "Goal orientation quaternion Z"
    },
    "goal_qw": {
      "type": "float",
      "default": 0.3942064046859741,
      "required": false,
      "description": "Goal orientation quaternion W"
    },
    "pos_tolerance": {
      "type": "float",
      "default": 0.1,
      "required": false,
      "description": "Position tolerance (m)"
    },
    "yaw_tolerance": {
      "type": "float",
      "default": 0.15,
      "required": false,
      "description": "Yaw tolerance (rad)"
    },
    "rosbag_output_dir": {
      "type": "string",
      "default": "~/lucid-agent-core/data/bags",
      "required": false,
      "description": "Rosbag dir on rosbot-pc"
    },
    "optitrack_rosbag_output_dir": {
      "type": "string",
      "default": "~/lucid-agent-core/data/bags",
      "required": false,
      "description": "Rosbag dir on the OptiTrack agent"
    },
    "camera_rosbag_output_dir": {
      "type": "string",
      "default": "~/lucid-agent-core-camera/data/bags",
      "required": false,
      "description": "Rosbag dir on the camera agent"
    },
    "wait_timeout_s": {
      "type": "float",
      "default": 60.0,
      "required": false,
      "description": "Max seconds to wait for reset_status.state == 'success'"
    }
  },
  "steps": [
    {
      "name": "defensive-stop-roslaunch",
      "type": "command",
      "on_failure": "continue",
      "agent_id": "${rosbot_pc_agent_id}",
      "component_id": "ros_bridge",
      "action": "roslaunch-stop",
      "timeout_s": 20,
      "params": {}
    },
    {
      "name": "enable-reset-telemetry",
      "type": "parallel",
      "on_failure": "abort",
      "steps": [
        {
          "name": "enable-optitrack-telemetry",
          "type": "command",
          "when": "${launch_hydra}",
          "on_failure": "abort",
          "agent_id": "${hydra_agent_id}",
          "component_id": "ros_bridge",
          "action": "cfg/telemetry/set",
          "timeout_s": 10,
          "params": {
            "set": {
              "optitrack_umh_6": {
                "enabled": true,
                "interval_s": 1.0,
                "change_threshold_percent": 0.0
              }
            }
          }
        },
        {
          "name": "enable-reset-status-telemetry",
          "type": "command",
          "when": "${launch_rosbot}",
          "on_failure": "abort",
          "agent_id": "${rosbot_pc_agent_id}",
          "component_id": "ros_bridge",
          "action": "cfg/telemetry/set",
          "timeout_s": 10,
          "params": {
            "set": {
              "reset_status": {
                "enabled": true,
                "interval_s": 3.0,
                "change_threshold_percent": 0.0
              }
            }
          }
        }
      ]
    },
    {
      "name": "create-optitrack-to-rosbot-link",
      "type": "topic_link",
      "when": "${launch_hydra}",
      "on_failure": "abort",
      "operation": "create",
      "source_topic": "lucid/agents/${hydra_agent_id}/components/ros_bridge/telemetry/optitrack_umh_6",
      "target_topic": "lucid/agents/${rosbot_pc_agent_id}/components/ros_bridge/cmd/optitrack_pose",
      "select_clause": "payload.value as value, id as request_id",
      "payload_template": "{\"request_id\": \"${request_id}\", \"data\": ${value}}",
      "qos": 0
    },
    {
      "name": "link-reset-distance-to-led",
      "type": "topic_link",
      "when": "${launch_led}",
      "on_failure": "continue",
      "operation": "create",
      "source_topic": "lucid/agents/${rosbot_pc_agent_id}/components/ros_bridge/telemetry/reset_status",
      "target_topic": "lucid/agents/${led_agent_id}/components/led_strip/cmd/set-range-percent",
      "select_clause": "(1.0 - (payload.value.pos_error / 2.0)) as end_pct, id as request_id",
      "payload_template": "{\"request_id\": \"${request_id}\", \"color\": {\"r\": 0, \"g\": 255, \"b\": 0}, \"start_percent\": 0.0, \"end_percent\": ${end_pct}}",
      "qos": 0
    },
    {
      "name": "start-reset-recordings",
      "type": "parallel",
      "on_failure": "continue",
      "steps": [
        {
          "name": "start-rosbot-reset-rosbag",
          "type": "command",
          "when": "${launch_rosbot}",
          "on_failure": "continue",
          "agent_id": "${rosbot_pc_agent_id}",
          "component_id": "ros_bridge",
          "action": "rosbag-start",
          "timeout_s": 15,
          "params": {
            "data": {
              "output_dir": "${rosbag_output_dir}",
              "prefix": "reset"
            }
          }
        },
        {
          "name": "start-optitrack-reset-rosbag",
          "type": "command",
          "when": "${launch_hydra}",
          "on_failure": "continue",
          "agent_id": "${optitrack_agent_id}",
          "component_id": "ros_bridge",
          "action": "rosbag-start",
          "timeout_s": 15,
          "params": {
            "data": {
              "output_dir": "${optitrack_rosbag_output_dir}",
              "prefix": "reset"
            }
          }
        },
        {
          "name": "start-camera-reset-rosbag",
          "type": "command",
          "when": "${launch_camera}",
          "on_failure": "continue",
          "agent_id": "${camera_agent_id}",
          "component_id": "ros_bridge",
          "action": "rosbag-start",
          "timeout_s": 15,
          "params": {
            "data": {
              "output_dir": "${camera_rosbag_output_dir}",
              "prefix": "reset"
            }
          }
        }
      ]
    },
    {
      "name": "start-reset-to-start",
      "type": "command",
      "on_failure": "abort",
      "agent_id": "${rosbot_pc_agent_id}",
      "component_id": "ros_bridge",
      "action": "roslaunch-start",
      "timeout_s": 30,
      "params": {
        "data": {
          "package": "foraging_bringup",
          "launch_file": "reset_to_start.launch",
          "args": {
            "goal_x": "${goal_x}",
            "goal_y": "${goal_y}",
            "goal_qx": "${goal_qx}",
            "goal_qy": "${goal_qy}",
            "goal_qz": "${goal_qz}",
            "goal_qw": "${goal_qw}",
            "pos_tolerance": "${pos_tolerance}",
            "yaw_tolerance": "${yaw_tolerance}"
          }
        }
      }
    },
    {
      "name": "wait-for-reset-success",
      "type": "wait_for_condition",
      "on_failure": "abort",
      "agent_id": "${rosbot_pc_agent_id}",
      "component_id": "ros_bridge",
      "telemetry_metric": "reset_status",
      "condition": {
        "field": "value.state",
        "equals": "success"
      },
      "timeout_s": "${wait_timeout_s}"
    },
    {
      "name": "stop-reset-launch",
      "type": "command",
      "on_failure": "continue",
      "agent_id": "${rosbot_pc_agent_id}",
      "component_id": "ros_bridge",
      "action": "roslaunch-stop",
      "timeout_s": 20,
      "params": {}
    },
    {
      "name": "stop-reset-recordings",
      "type": "parallel",
      "on_failure": "continue",
      "steps": [
        {
          "name": "stop-rosbot-reset-rosbag",
          "type": "command",
          "when": "${launch_rosbot}",
          "on_failure": "continue",
          "agent_id": "${rosbot_pc_agent_id}",
          "component_id": "ros_bridge",
          "action": "rosbag-stop",
          "timeout_s": 15,
          "params": {}
        },
        {
          "name": "stop-optitrack-reset-rosbag",
          "type": "command",
          "when": "${launch_hydra}",
          "on_failure": "continue",
          "agent_id": "${optitrack_agent_id}",
          "component_id": "ros_bridge",
          "action": "rosbag-stop",
          "timeout_s": 15,
          "params": {}
        },
        {
          "name": "stop-camera-reset-rosbag",
          "type": "command",
          "when": "${launch_camera}",
          "on_failure": "continue",
          "agent_id": "${camera_agent_id}",
          "component_id": "ros_bridge",
          "action": "rosbag-stop",
          "timeout_s": 15,
          "params": {}
        }
      ]
    },
    {
      "name": "delete-link-reset-distance-to-led",
      "type": "topic_link",
      "when": "${launch_led}",
      "on_failure": "continue",
      "operation": "delete",
      "source_topic": "lucid/agents/${rosbot_pc_agent_id}/components/ros_bridge/telemetry/reset_status",
      "target_topic": "lucid/agents/${led_agent_id}/components/led_strip/cmd/set-range-percent",
      "select_clause": "*",
      "qos": 0
    },
    {
      "name": "delete-link-optitrack-to-rosbot",
      "type": "topic_link",
      "when": "${launch_hydra}",
      "on_failure": "continue",
      "operation": "delete",
      "source_topic": "lucid/agents/${hydra_agent_id}/components/ros_bridge/telemetry/optitrack_umh_6",
      "target_topic": "lucid/agents/${rosbot_pc_agent_id}/components/ros_bridge/cmd/optitrack_pose",
      "select_clause": "*",
      "qos": 0
    },
    {
      "name": "disable-reset-telemetry",
      "type": "parallel",
      "on_failure": "continue",
      "steps": [
        {
          "name": "disable-optitrack-telemetry",
          "type": "command",
          "when": "${launch_hydra}",
          "on_failure": "continue",
          "agent_id": "${hydra_agent_id}",
          "component_id": "ros_bridge",
          "action": "cfg/telemetry/set",
          "timeout_s": 10,
          "params": {
            "set": {
              "optitrack_umh_6": {
                "enabled": false
              }
            }
          }
        },
        {
          "name": "disable-reset-status-telemetry",
          "type": "command",
          "when": "${launch_rosbot}",
          "on_failure": "continue",
          "agent_id": "${rosbot_pc_agent_id}",
          "component_id": "ros_bridge",
          "action": "cfg/telemetry/set",
          "timeout_s": 10,
          "params": {
            "set": {
              "reset_status": {
                "enabled": false
              }
            }
          }
        }
      ]
    }
  ]
}
