{
  "id": "foraging-startup-postfire",
  "name": "Foraging Startup (postfire)",
  "version": "1.0.0",
  "description": "Brings up the always-on services for foraging after the fire rebuild: camera and optitrack \u2014 in parallel. No projectors / NDI / TouchDesigner / chrony in this configuration.",
  "tags": [
    "bringup",
    "foraging",
    "startup",
    "postfire"
  ],
  "parameters": {
    "led_agent_id": {
      "type": "string",
      "default": "led_truss",
      "required": false,
      "description": "LED truss agent (visual startup indicator)"
    },
    "hydra_agent_id": {
      "type": "string",
      "default": "hydra",
      "required": false,
      "description": "Hydra agent (KNX + OptiTrack)"
    },
    "camera_agent_id": {
      "type": "string",
      "default": "camera",
      "required": false,
      "description": "Camera agent"
    },
    "room_brightness": {
      "type": "integer",
      "default": 1,
      "required": false,
      "description": "KNX 'Experiments light' brightness 0-100 (1 = dim for experiments)"
    },
    "sensor_settle_s": {
      "type": "float",
      "default": 10.0,
      "required": false,
      "description": "Shared sensor settle delay for camera and optitrack bringups"
    },
    "roscore_settle_s": {
      "type": "float",
      "default": 10.0,
      "required": false,
      "description": "Shared roscore settle delay for camera and optitrack bringups"
    }
  },
  "steps": [
    {
      "qos": 0,
      "name": "startup-services",
      "type": "parallel",
      "steps": [
        {
          "qos": 0,
          "name": "led-startup-glow",
          "type": "command",
          "action": "effect/glow",
          "params": {
            "color": {
              "b": 0,
              "g": 150,
              "r": 255
            },
            "wait_ms": 25
          },
          "retries": 0,
          "agent_id": "${led_agent_id}",
          "operation": "create",
          "timeout_s": 10.0,
          "on_failure": "continue",
          "on_timeout": "abort",
          "component_id": "led_strip",
          "select_clause": "*",
          "template_params": {}
        },
        {
          "qos": 0,
          "name": "dim-room-lights",
          "type": "command",
          "action": "light/brightness/set",
          "params": {
            "light": "all",
            "brightness": "${room_brightness}"
          },
          "retries": 0,
          "agent_id": "${hydra_agent_id}",
          "operation": "create",
          "timeout_s": 10.0,
          "on_failure": "continue",
          "on_timeout": "abort",
          "component_id": "knx",
          "select_clause": "*",
          "template_params": {}
        },
        {
          "qos": 0,
          "name": "camera",
          "type": "template",
          "params": {},
          "retries": 0,
          "operation": "create",
          "timeout_s": 30.0,
          "on_failure": "abort",
          "on_timeout": "abort",
          "template_id": "camera-bringup-postfire",
          "select_clause": "*",
          "template_params": {
            "camera_agent_id": "${camera_agent_id}",
            "sensor_settle_s": "${sensor_settle_s}",
            "roscore_settle_s": "${roscore_settle_s}"
          }
        },
        {
          "qos": 0,
          "name": "optitrack",
          "type": "template",
          "params": {},
          "retries": 0,
          "operation": "create",
          "timeout_s": 30.0,
          "on_failure": "abort",
          "on_timeout": "abort",
          "template_id": "optitrack-bringup-postfire",
          "select_clause": "*",
          "template_params": {
            "hydra_agent_id": "${hydra_agent_id}",
            "sensor_settle_s": "${sensor_settle_s}",
            "roscore_settle_s": "${roscore_settle_s}"
          }
        }
      ],
      "params": {},
      "retries": 0,
      "operation": "create",
      "timeout_s": 30.0,
      "on_failure": "abort",
      "on_timeout": "abort",
      "select_clause": "*",
      "template_params": {}
    }
  ]
}
