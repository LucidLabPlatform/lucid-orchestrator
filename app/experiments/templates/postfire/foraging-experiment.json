{
  "id": "foraging-experiment-postfire",
  "name": "Foraging Experiment (v2, postfire)",
  "version": "1.0.0",
  "description": "Top-level foraging experiment using the v2 bringup sub-templates (postfire variant: no projectors / NDI). Optionally runs always-on services bringup, always restarts the arena on viz, then chains rosbot-bringup \u2192 foraging-reset-v2 \u2192 puck approval \u2192 rosbot-bringup (with rosserial) \u2192 foraging-run-v2.",
  "tags": [
    "bringup",
    "foraging",
    "experiment",
    "postfire"
  ],
  "parameters": {
    "goal_x": {
      "type": "float",
      "default": 0.2546336352825165,
      "required": false,
      "description": "Reset goal X (OptiTrack frame)"
    },
    "goal_y": {
      "type": "float",
      "default": 0.2405686378479004,
      "required": false,
      "description": "Reset goal Y (OptiTrack frame)"
    },
    "goal_qw": {
      "type": "float",
      "default": -0.9080696702003479,
      "required": false,
      "description": "Goal orientation quaternion W"
    },
    "goal_qx": {
      "type": "float",
      "default": -0.03810122236609459,
      "required": false,
      "description": "Goal orientation quaternion X"
    },
    "goal_qy": {
      "type": "float",
      "default": -0.08715175837278366,
      "required": false,
      "description": "Goal orientation quaternion Y"
    },
    "goal_qz": {
      "type": "float",
      "default": 0.4078754484653473,
      "required": false,
      "description": "Goal orientation quaternion Z"
    },
    "max_vel_x": {
      "type": "string",
      "default": "0.2",
      "required": false,
      "description": "Max forward velocity (m/s)"
    },
    "num_pucks": {
      "type": "string",
      "default": "3",
      "required": false,
      "description": "Number of pucks (foraging launch arg)"
    },
    "open_rviz": {
      "type": "string",
      "default": "false",
      "required": false,
      "description": "Whether to open rviz on the rosbot"
    },
    "step_size": {
      "type": "string",
      "default": "0.5",
      "required": false,
      "description": "Random walk step size (m)"
    },
    "launch_led": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Drive LED truss colour and effects throughout"
    },
    "walk_sigma": {
      "type": "string",
      "default": "0.5",
      "required": false,
      "description": "Random walk yaw sigma"
    },
    "num_corners": {
      "type": "string",
      "default": "3",
      "required": false,
      "description": "Number of corners (foraging launch arg)"
    },
    "launch_hydra": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Enable hydra OptiTrack telemetry and recording"
    },
    "launch_camera": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Record camera rosbags during reset and run"
    },
    "launch_rosbot": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Enable rosbot_pc telemetry, recording, and roslaunches in reset and run"
    },
    "pos_tolerance": {
      "type": "float",
      "default": 0.1,
      "required": false,
      "description": "Reset position tolerance (m)"
    },
    "yaw_tolerance": {
      "type": "float",
      "default": 0.15,
      "required": false,
      "description": "Reset yaw tolerance (rad)"
    },
    "arena_anchor_x": {
      "type": "float",
      "default": 0.0,
      "required": false,
      "description": "Anchor corner X in OptiTrack frame"
    },
    "arena_anchor_y": {
      "type": "float",
      "default": 0.0,
      "required": false,
      "description": "Anchor corner Y in OptiTrack frame"
    },
    "launch_startup": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Run foraging-startup (chrony, camera, optitrack, LED). Skip on warm sessions where services are already up."
    },
    "restart_docker": {
      "type": "boolean",
      "default": false,
      "required": false,
      "description": "Force a docker restart in the first rosbot-bringup call (kill spawn + compose down before bringing it back up)"
    },
    "launch_socrates": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Create viz topic links during run. Postfire still has no projectors / TouchDesigner, but the arena viz on socrates is active."
    },
    "explore_puck_pct": {
      "type": "float",
      "default": 0.3,
      "required": false,
      "description": "Fraction of explore time spent on pucks"
    },
    "explore_corner_pct": {
      "type": "float",
      "default": 0.4,
      "required": false,
      "description": "Fraction of explore time spent on corners"
    },
    "wait_timeout_s_run": {
      "type": "float",
      "default": 600.0,
      "required": false,
      "description": "Max seconds for foraging_status.state in {completed, error}"
    },
    "arena_anchor_corner": {
      "type": "string",
      "default": "TR",
      "required": false,
      "description": "Which arena corner is anchored in OptiTrack (TL/TR/BR/BL)"
    },
    "wait_timeout_s_reset": {
      "type": "float",
      "default": 60.0,
      "required": false,
      "description": "Max seconds for reset_status.state == 'success'"
    }
  },
  "steps": [
    {
      "qos": 0,
      "name": "foraging-startup",
      "type": "template",
      "when": "${launch_startup}",
      "params": {},
      "retries": 0,
      "operation": "create",
      "timeout_s": 30.0,
      "on_failure": "abort",
      "on_timeout": "abort",
      "template_id": "foraging-startup-postfire",
      "select_clause": "*",
      "template_params": {}
    },
    {
      "qos": 0,
      "name": "restart-arena",
      "type": "command",
      "action": "start_arena",
      "params": {
        "goal_x": "${goal_x}",
        "goal_y": "${goal_y}",
        "goal_qw": "${goal_qw}",
        "goal_qx": "${goal_qx}",
        "goal_qy": "${goal_qy}",
        "goal_qz": "${goal_qz}",
        "arena_anchor_x": "${arena_anchor_x}",
        "arena_anchor_y": "${arena_anchor_y}",
        "arena_anchor_corner": "${arena_anchor_corner}"
      },
      "retries": 0,
      "agent_id": "socrates",
      "operation": "create",
      "timeout_s": 30.0,
      "on_failure": "abort",
      "on_timeout": "abort",
      "component_id": "viz",
      "select_clause": "*",
      "template_params": {}
    },
    {
      "qos": 0,
      "name": "rosbot-bringup-no-rosserial",
      "type": "template",
      "params": {},
      "retries": 0,
      "operation": "create",
      "timeout_s": 30.0,
      "on_failure": "abort",
      "on_timeout": "abort",
      "template_id": "rosbot-bringup-postfire",
      "select_clause": "*",
      "template_params": {
        "restart_docker": "${restart_docker}",
        "launch_rosserial": false,
        "restart_ros_bridge": true
      }
    },
    {
      "qos": 0,
      "name": "foraging-reset",
      "type": "template",
      "params": {},
      "retries": 0,
      "operation": "create",
      "timeout_s": 30.0,
      "on_failure": "abort",
      "on_timeout": "abort",
      "template_id": "foraging-reset-postfire",
      "select_clause": "*",
      "template_params": {
        "goal_x": "${goal_x}",
        "goal_y": "${goal_y}",
        "goal_qw": "${goal_qw}",
        "goal_qx": "${goal_qx}",
        "goal_qy": "${goal_qy}",
        "goal_qz": "${goal_qz}",
        "launch_led": "${launch_led}",
        "launch_hydra": "${launch_hydra}",
        "launch_camera": "${launch_camera}",
        "launch_rosbot": "${launch_rosbot}",
        "pos_tolerance": "${pos_tolerance}",
        "yaw_tolerance": "${yaw_tolerance}",
        "wait_timeout_s": "${wait_timeout_s_reset}"
      }
    },
    {
      "qos": 0,
      "name": "puck-approval",
      "type": "template",
      "params": {},
      "retries": 0,
      "operation": "create",
      "timeout_s": 30.0,
      "on_failure": "abort",
      "on_timeout": "abort",
      "template_id": "foraging-puck-approval-postfire",
      "select_clause": "*",
      "template_params": {
        "launch_led": "${launch_led}"
      }
    },
    {
      "qos": 0,
      "name": "rosbot-bringup-with-rosserial",
      "type": "template",
      "params": {},
      "retries": 0,
      "operation": "create",
      "timeout_s": 30.0,
      "on_failure": "abort",
      "on_timeout": "abort",
      "template_id": "rosbot-bringup-postfire",
      "select_clause": "*",
      "template_params": {
        "restart_docker": true,
        "launch_rosserial": true,
        "restart_ros_bridge": true
      }
    },
    {
      "qos": 0,
      "name": "foraging-run",
      "type": "template",
      "params": {},
      "retries": 0,
      "operation": "create",
      "timeout_s": 30.0,
      "on_failure": "abort",
      "on_timeout": "abort",
      "template_id": "foraging-run-postfire",
      "select_clause": "*",
      "template_params": {
        "max_vel_x": "${max_vel_x}",
        "num_pucks": "${num_pucks}",
        "open_rviz": "${open_rviz}",
        "step_size": "${step_size}",
        "launch_led": "${launch_led}",
        "walk_sigma": "${walk_sigma}",
        "num_corners": "${num_corners}",
        "launch_hydra": "${launch_hydra}",
        "launch_camera": "${launch_camera}",
        "launch_rosbot": "${launch_rosbot}",
        "wait_timeout_s": "${wait_timeout_s_run}",
        "launch_socrates": "${launch_socrates}",
        "explore_puck_pct": "${explore_puck_pct}",
        "explore_corner_pct": "${explore_corner_pct}"
      }
    }
  ]
}
