{
  "id": "foraging-run-postfire",
  "name": "Foraging Run (v2, postfire)",
  "version": "1.0.0",
  "description": "Targets the renamed rosbot_pc agent. Enables foraging telemetry, creates 5 viz/LED topic links, starts rosbag recordings, runs foraging_experiment.launch, waits up to 10 min for completion, signals end via LED rainbow, then stops recordings and tears down all links + telemetry it created. Assumes rosbot-bringup ran first (so docker / rosserial / ros_bridge are up). Postfire default: no viz/socrates (no projectors).",
  "tags": [
    "bringup",
    "foraging",
    "run",
    "postfire"
  ],
  "parameters": {
    "max_vel_x": {
      "type": "string",
      "default": "0.2",
      "required": false,
      "description": "Max forward velocity (m/s)"
    },
    "num_pucks": {
      "type": "string",
      "default": "3",
      "required": false,
      "description": "Number of pucks (passed as roslaunch arg)"
    },
    "open_rviz": {
      "type": "string",
      "default": "false",
      "required": false,
      "description": "Whether to open rviz on the rosbot (via roslaunch arg, not the gui-component rviz below)"
    },
    "step_size": {
      "type": "string",
      "default": "0.5",
      "required": false,
      "description": "Random walk step size (m)"
    },
    "launch_led": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Drive LED colour from foraging_status mode + rainbow on completion"
    },
    "walk_sigma": {
      "type": "string",
      "default": "0.5",
      "required": false,
      "description": "Random walk yaw sigma"
    },
    "launch_rviz": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Launch rviz via the gui component on rviz_agent_id"
    },
    "num_corners": {
      "type": "string",
      "default": "3",
      "required": false,
      "description": "Number of corners (passed as roslaunch arg)"
    },
    "rviz_config": {
      "type": "string",
      "default": "/home/forfaly/foraging_ws/src/foraging_bringup/rviz/foraging_rviz_config.rviz",
      "required": false,
      "description": "Absolute path to the .rviz config file (visible to rviz_agent_id)"
    },
    "rviz_ros_ip": {
      "type": "string",
      "default": "10.205.9.21",
      "required": false,
      "description": "ROS_IP for the rviz process"
    },
    "launch_hydra": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Enable OptiTrack telemetry and recording"
    },
    "led_agent_id": {
      "type": "string",
      "default": "led_truss",
      "required": false,
      "description": "LED truss agent"
    },
    "launch_camera": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Record the camera rosbag during run"
    },
    "launch_rosbot": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Enable rosbot_pc telemetry, recording, and foraging roslaunch"
    },
    "rviz_agent_id": {
      "type": "string",
      "default": "camera",
      "required": false,
      "description": "Agent running the gui component that will host rviz"
    },
    "hydra_agent_id": {
      "type": "string",
      "default": "hydra",
      "required": false,
      "description": "Hydra agent (OptiTrack)"
    },
    "roslaunch_file": {
      "type": "string",
      "default": "foraging_experiment.launch",
      "required": false,
      "description": "Launch file name"
    },
    "wait_timeout_s": {
      "type": "float",
      "default": 600,
      "required": false,
      "description": "Max seconds to wait for foraging_status.state in {completed, error}"
    },
    "camera_agent_id": {
      "type": "string",
      "default": "camera",
      "required": false,
      "description": "Camera agent"
    },
    "launch_socrates": {
      "type": "boolean",
      "default": true,
      "required": false,
      "description": "Create viz topic links (puck/aruco/odom/optitrack pose). Postfire has no projectors / TouchDesigner, but the arena viz on socrates is active."
    },
    "explore_puck_pct": {
      "type": "float",
      "default": 0.3,
      "required": false,
      "description": "Fraction of explore time spent on pucks"
    },
    "rosbag_output_dir": {
      "type": "string",
      "default": "~/lucid-agent-core-rosbot-pc/data/bags",
      "required": false,
      "description": "Rosbag dir on rosbot_pc"
    },
    "roslaunch_package": {
      "type": "string",
      "default": "foraging_bringup",
      "required": false,
      "description": "ROS package containing the foraging launch file"
    },
    "socrates_agent_id": {
      "type": "string",
      "default": "socrates",
      "required": false,
      "description": "Viz agent (target of the 4 viz topic links)"
    },
    "explore_corner_pct": {
      "type": "float",
      "default": 0.4,
      "required": false,
      "description": "Fraction of explore time spent on corners"
    },
    "optitrack_agent_id": {
      "type": "string",
      "default": "hydra",
      "required": false,
      "description": "Agent that records the OptiTrack rosbag (usually hydra)"
    },
    "rosbot_pc_agent_id": {
      "type": "string",
      "default": "rosbot_pc",
      "required": false,
      "description": "Agent running ros_bridge for the rosbot ROS master"
    },
    "rviz_ros_master_uri": {
      "type": "string",
      "default": "http://10.205.3.21:11311",
      "required": false,
      "description": "ROS_MASTER_URI for the rviz process"
    },
    "rviz_workspace_setup": {
      "type": "string",
      "default": "/home/forfaly/foraging_ws/devel/setup.bash",
      "required": false,
      "description": "Catkin workspace setup.bash sourced before launching rviz (system /opt/ros/noetic/setup.bash is always sourced first)"
    },
    "camera_rosbag_output_dir": {
      "type": "string",
      "default": "~/lucid-agent-core/data/bags",
      "required": false,
      "description": "Rosbag dir on the camera agent"
    },
    "optitrack_rosbag_output_dir": {
      "type": "string",
      "default": "~/lucid-agent-core/data/bags",
      "required": false,
      "description": "Rosbag dir on the OptiTrack agent"
    }
  },
  "steps": [
    {
      "qos": 0,
      "name": "defensive-stop-roslaunch",
      "type": "command",
      "action": "roslaunch-stop",
      "params": {},
      "retries": 0,
      "agent_id": "${rosbot_pc_agent_id}",
      "operation": "create",
      "timeout_s": 20.0,
      "on_failure": "continue",
      "on_timeout": "abort",
      "component_id": "ros_bridge",
      "select_clause": "*",
      "template_params": {}
    },
    {
      "qos": 0,
      "name": "enable-foraging-telemetry",
      "type": "parallel",
      "steps": [
        {
          "qos": 0,
          "name": "enable-optitrack-telemetry",
          "type": "command",
          "when": "${launch_hydra}",
          "action": "cfg/telemetry/set",
          "params": {
            "set": {
              "optitrack_umh_6": {
                "enabled": true,
                "interval_s": 1,
                "change_threshold_percent": 0
              }
            }
          },
          "retries": 0,
          "agent_id": "${hydra_agent_id}",
          "operation": "create",
          "timeout_s": 10.0,
          "on_failure": "abort",
          "on_timeout": "abort",
          "component_id": "ros_bridge",
          "select_clause": "*",
          "template_params": {}
        },
        {
          "qos": 0,
          "name": "enable-rosbot-foraging-telemetry",
          "type": "command",
          "when": "${launch_rosbot}",
          "action": "cfg/telemetry/set",
          "params": {
            "set": {
              "odom": {
                "enabled": true,
                "interval_s": 1,
                "change_threshold_percent": 0
              },
              "puck_registry": {
                "enabled": true,
                "interval_s": 1,
                "change_threshold_percent": 0
              },
              "aruco_registry": {
                "enabled": true,
                "interval_s": 1,
                "change_threshold_percent": 0
              },
              "foraging_status": {
                "enabled": true,
                "interval_s": 1,
                "change_threshold_percent": 0
              }
            }
          },
          "retries": 0,
          "agent_id": "${rosbot_pc_agent_id}",
          "operation": "create",
          "timeout_s": 10.0,
          "on_failure": "abort",
          "on_timeout": "abort",
          "component_id": "ros_bridge",
          "select_clause": "*",
          "template_params": {}
        }
      ],
      "params": {},
      "retries": 0,
      "operation": "create",
      "timeout_s": 30.0,
      "on_failure": "abort",
      "on_timeout": "abort",
      "select_clause": "*",
      "template_params": {}
    },
    {
      "qos": 0,
      "name": "create-foraging-topic-links",
      "type": "parallel",
      "steps": [
        {
          "qos": 0,
          "name": "link-puck-registry-to-viz",
          "type": "topic_link",
          "when": "${launch_socrates}",
          "params": {},
          "retries": 0,
          "operation": "create",
          "timeout_s": 30.0,
          "on_failure": "continue",
          "on_timeout": "abort",
          "source_topic": "lucid/agents/${rosbot_pc_agent_id}/components/ros_bridge/telemetry/puck_registry",
          "target_topic": "lucid/agents/${socrates_agent_id}/components/viz/cmd/puck_registry",
          "select_clause": "payload.value as value, id as request_id",
          "template_params": {},
          "payload_template": "{\"request_id\": \"${request_id}\", \"value\": ${value}}"
        },
        {
          "qos": 0,
          "name": "link-aruco-registry-to-viz",
          "type": "topic_link",
          "when": "${launch_socrates}",
          "params": {},
          "retries": 0,
          "operation": "create",
          "timeout_s": 30.0,
          "on_failure": "continue",
          "on_timeout": "abort",
          "source_topic": "lucid/agents/${rosbot_pc_agent_id}/components/ros_bridge/telemetry/aruco_registry",
          "target_topic": "lucid/agents/${socrates_agent_id}/components/viz/cmd/aruco_registry",
          "select_clause": "payload.value as value, id as request_id",
          "template_params": {},
          "payload_template": "{\"request_id\": \"${request_id}\", \"value\": ${value}}"
        },
        {
          "qos": 0,
          "name": "link-odom-to-viz",
          "type": "topic_link",
          "when": "${launch_socrates}",
          "params": {},
          "retries": 0,
          "operation": "create",
          "timeout_s": 30.0,
          "on_failure": "continue",
          "on_timeout": "abort",
          "source_topic": "lucid/agents/${rosbot_pc_agent_id}/components/ros_bridge/telemetry/odom",
          "target_topic": "lucid/agents/${socrates_agent_id}/components/viz/cmd/robot_pose_odom",
          "select_clause": "payload.value.pose.pose.position.x as px, payload.value.pose.pose.position.y as py, payload.value.pose.pose.orientation.x as ox, payload.value.pose.pose.orientation.y as oy, payload.value.pose.pose.orientation.z as oz, payload.value.pose.pose.orientation.w as ow, id as request_id",
          "template_params": {},
          "payload_template": "{\"request_id\": \"${request_id}\", \"value\": {\"pose\": {\"position\": {\"x\": ${px}, \"y\": ${py}}, \"orientation\": {\"x\": ${ox}, \"y\": ${oy}, \"z\": ${oz}, \"w\": ${ow}}}}}"
        },
        {
          "qos": 0,
          "name": "link-optitrack-pose-to-viz",
          "type": "topic_link",
          "when": "${launch_socrates}",
          "params": {},
          "retries": 0,
          "operation": "create",
          "timeout_s": 30.0,
          "on_failure": "continue",
          "on_timeout": "abort",
          "source_topic": "lucid/agents/${optitrack_agent_id}/components/ros_bridge/telemetry/optitrack_umh_6",
          "target_topic": "lucid/agents/${socrates_agent_id}/components/viz/cmd/robot_pose_optitrack",
          "select_clause": "payload.value.pose.position.x as px, payload.value.pose.position.y as py, payload.value.pose.position.z as pz, payload.value.pose.orientation.x as ox, payload.value.pose.orientation.y as oy, payload.value.pose.orientation.z as oz, payload.value.pose.orientation.w as ow, id as request_id",
          "template_params": {},
          "payload_template": "{\"request_id\": \"${request_id}\", \"value\": {\"pose\": {\"position\": {\"x\": ${px}, \"y\": ${py}, \"z\": ${pz}}, \"orientation\": {\"x\": ${ox}, \"y\": ${oy}, \"z\": ${oz}, \"w\": ${ow}}}}}"
        },
        {
          "qos": 0,
          "name": "link-foraging-mode-to-led",
          "type": "topic_link",
          "when": "${launch_led}",
          "params": {},
          "retries": 0,
          "operation": "create",
          "timeout_s": 30.0,
          "on_failure": "continue",
          "on_timeout": "abort",
          "source_topic": "lucid/agents/${rosbot_pc_agent_id}/components/ros_bridge/telemetry/foraging_status",
          "target_topic": "lucid/agents/${led_agent_id}/components/led_strip/cmd/set-color",
          "select_clause": "CASE payload.value.mode WHEN 0 THEN 0 WHEN 1 THEN 255 WHEN 2 THEN 0 ELSE 255 END as r, CASE payload.value.mode WHEN 0 THEN 0 WHEN 1 THEN 255 WHEN 2 THEN 255 ELSE 0 END as g, CASE payload.value.mode WHEN 0 THEN 255 WHEN 1 THEN 0 WHEN 2 THEN 0 ELSE 0 END as b, id as request_id",
          "template_params": {},
          "payload_template": "{\"request_id\": \"${request_id}\", \"color\": {\"r\": ${r}, \"g\": ${g}, \"b\": ${b}}}"
        }
      ],
      "params": {},
      "retries": 0,
      "operation": "create",
      "timeout_s": 30.0,
      "on_failure": "abort",
      "on_timeout": "abort",
      "select_clause": "*",
      "template_params": {}
    },
    {
      "qos": 0,
      "name": "start-foraging-recordings",
      "type": "parallel",
      "steps": [
        {
          "qos": 0,
          "name": "start-rosbot-foraging-rosbag",
          "type": "command",
          "when": "${launch_rosbot}",
          "action": "rosbag-start",
          "params": {
            "data": {
              "prefix": "foraging",
              "output_dir": "${rosbag_output_dir}"
            }
          },
          "retries": 0,
          "agent_id": "${rosbot_pc_agent_id}",
          "operation": "create",
          "timeout_s": 15.0,
          "on_failure": "continue",
          "on_timeout": "abort",
          "component_id": "ros_bridge",
          "select_clause": "*",
          "template_params": {}
        },
        {
          "qos": 0,
          "name": "start-optitrack-foraging-rosbag",
          "type": "command",
          "when": "${launch_hydra}",
          "action": "rosbag-start",
          "params": {
            "data": {
              "prefix": "foraging",
              "output_dir": "${optitrack_rosbag_output_dir}"
            }
          },
          "retries": 0,
          "agent_id": "${optitrack_agent_id}",
          "operation": "create",
          "timeout_s": 15.0,
          "on_failure": "continue",
          "on_timeout": "abort",
          "component_id": "ros_bridge",
          "select_clause": "*",
          "template_params": {}
        },
        {
          "qos": 0,
          "name": "start-camera-foraging-rosbag",
          "type": "command",
          "when": "${launch_camera}",
          "action": "rosbag-start",
          "params": {
            "data": {
              "prefix": "foraging",
              "output_dir": "${camera_rosbag_output_dir}"
            }
          },
          "retries": 0,
          "agent_id": "${camera_agent_id}",
          "operation": "create",
          "timeout_s": 15.0,
          "on_failure": "continue",
          "on_timeout": "abort",
          "component_id": "ros_bridge",
          "select_clause": "*",
          "template_params": {}
        }
      ],
      "params": {},
      "retries": 0,
      "operation": "create",
      "timeout_s": 30.0,
      "on_failure": "continue",
      "on_timeout": "abort",
      "select_clause": "*",
      "template_params": {}
    },
    {
      "qos": 0,
      "name": "start-rviz",
      "type": "command",
      "when": "${launch_rviz}",
      "action": "launch",
      "params": {
        "env": {
          "ROS_IP": "${rviz_ros_ip}",
          "ROS_MASTER_URI": "${rviz_ros_master_uri}"
        },
        "args": [
          "-c",
          "source /opt/ros/noetic/setup.bash && source ${rviz_workspace_setup} && exec rviz -d ${rviz_config}"
        ],
        "name": "rviz_foraging",
        "command": "bash"
      },
      "retries": 0,
      "agent_id": "${rviz_agent_id}",
      "operation": "create",
      "timeout_s": 15.0,
      "on_failure": "continue",
      "on_timeout": "abort",
      "component_id": "gui",
      "select_clause": "*",
      "template_params": {}
    },
    {
      "qos": 0,
      "name": "start-foraging",
      "type": "command",
      "action": "roslaunch-start",
      "params": {
        "data": {
          "args": {
            "max_vel_x": "${max_vel_x}",
            "num_pucks": "${num_pucks}",
            "open_rviz": "${open_rviz}",
            "step_size": "${step_size}",
            "walk_sigma": "${walk_sigma}",
            "num_corners": "${num_corners}",
            "explore_puck_pct": "${explore_puck_pct}",
            "explore_corner_pct": "${explore_corner_pct}"
          },
          "package": "${roslaunch_package}",
          "launch_file": "${roslaunch_file}"
        }
      },
      "retries": 0,
      "agent_id": "${rosbot_pc_agent_id}",
      "operation": "create",
      "timeout_s": 30.0,
      "on_failure": "abort",
      "on_timeout": "abort",
      "component_id": "ros_bridge",
      "select_clause": "*",
      "template_params": {}
    },
    {
      "qos": 0,
      "name": "wait-for-foraging-complete",
      "type": "wait_for_condition",
      "params": {},
      "retries": 0,
      "agent_id": "${rosbot_pc_agent_id}",
      "condition": {
        "in": [
          "completed",
          "error"
        ],
        "field": "value.state"
      },
      "operation": "create",
      "timeout_s": "${wait_timeout_s}",
      "on_failure": "abort",
      "on_timeout": "continue",
      "component_id": "ros_bridge",
      "select_clause": "*",
      "template_params": {},
      "telemetry_metric": "foraging_status"
    },
    {
      "qos": 0,
      "name": "stop-foraging-launch",
      "type": "command",
      "action": "roslaunch-stop",
      "params": {},
      "retries": 0,
      "agent_id": "${rosbot_pc_agent_id}",
      "operation": "create",
      "timeout_s": 20.0,
      "on_failure": "continue",
      "on_timeout": "abort",
      "component_id": "ros_bridge",
      "select_clause": "*",
      "template_params": {}
    },
    {
      "qos": 0,
      "name": "stop-rviz",
      "type": "command",
      "when": "${launch_rviz}",
      "action": "kill",
      "params": {
        "name": "rviz_foraging"
      },
      "retries": 0,
      "agent_id": "${rviz_agent_id}",
      "operation": "create",
      "timeout_s": 10.0,
      "on_failure": "continue",
      "on_timeout": "abort",
      "component_id": "gui",
      "select_clause": "*",
      "template_params": {}
    },
    {
      "qos": 0,
      "name": "delete-link-foraging-mode-to-led",
      "type": "topic_link",
      "when": "${launch_led}",
      "params": {},
      "retries": 0,
      "operation": "delete",
      "timeout_s": 30.0,
      "on_failure": "continue",
      "on_timeout": "abort",
      "source_topic": "lucid/agents/${rosbot_pc_agent_id}/components/ros_bridge/telemetry/foraging_status",
      "target_topic": "lucid/agents/${led_agent_id}/components/led_strip/cmd/set-color",
      "select_clause": "*",
      "template_params": {}
    },
    {
      "qos": 0,
      "name": "led-foraging-complete",
      "type": "command",
      "when": "${launch_led}",
      "action": "effect/rainbow",
      "params": {
        "wait_ms": 10
      },
      "retries": 0,
      "agent_id": "${led_agent_id}",
      "operation": "create",
      "timeout_s": 10.0,
      "on_failure": "continue",
      "on_timeout": "abort",
      "component_id": "led_strip",
      "select_clause": "*",
      "template_params": {}
    },
    {
      "qos": 0,
      "name": "stop-foraging-recordings",
      "type": "parallel",
      "steps": [
        {
          "qos": 0,
          "name": "stop-rosbot-foraging-rosbag",
          "type": "command",
          "when": "${launch_rosbot}",
          "action": "rosbag-stop",
          "params": {},
          "retries": 0,
          "agent_id": "${rosbot_pc_agent_id}",
          "operation": "create",
          "timeout_s": 15.0,
          "on_failure": "continue",
          "on_timeout": "abort",
          "component_id": "ros_bridge",
          "select_clause": "*",
          "template_params": {}
        },
        {
          "qos": 0,
          "name": "stop-optitrack-foraging-rosbag",
          "type": "command",
          "when": "${launch_hydra}",
          "action": "rosbag-stop",
          "params": {},
          "retries": 0,
          "agent_id": "${optitrack_agent_id}",
          "operation": "create",
          "timeout_s": 15.0,
          "on_failure": "continue",
          "on_timeout": "abort",
          "component_id": "ros_bridge",
          "select_clause": "*",
          "template_params": {}
        },
        {
          "qos": 0,
          "name": "stop-camera-foraging-rosbag",
          "type": "command",
          "when": "${launch_camera}",
          "action": "rosbag-stop",
          "params": {},
          "retries": 0,
          "agent_id": "${camera_agent_id}",
          "operation": "create",
          "timeout_s": 15.0,
          "on_failure": "continue",
          "on_timeout": "abort",
          "component_id": "ros_bridge",
          "select_clause": "*",
          "template_params": {}
        }
      ],
      "params": {},
      "retries": 0,
      "operation": "create",
      "timeout_s": 30.0,
      "on_failure": "continue",
      "on_timeout": "abort",
      "select_clause": "*",
      "template_params": {}
    },
    {
      "qos": 0,
      "name": "delete-foraging-viz-links",
      "type": "parallel",
      "steps": [
        {
          "qos": 0,
          "name": "delete-link-puck-registry-to-viz",
          "type": "topic_link",
          "when": "${launch_socrates}",
          "params": {},
          "retries": 0,
          "operation": "delete",
          "timeout_s": 30.0,
          "on_failure": "continue",
          "on_timeout": "abort",
          "source_topic": "lucid/agents/${rosbot_pc_agent_id}/components/ros_bridge/telemetry/puck_registry",
          "target_topic": "lucid/agents/${socrates_agent_id}/components/viz/cmd/puck_registry",
          "select_clause": "*",
          "template_params": {}
        },
        {
