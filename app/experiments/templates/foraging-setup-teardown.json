{
  "id": "foraging-setup-teardown",
  "name": "Foraging Setup Teardown",
  "version": "1.0.0",
  "description": "Tears down the foraging setup: stops sensors, roscores, and rosbot docker.",
  "tags": ["foraging", "teardown"],
  "parameters": {
    "robot_id":           { "type": "string",  "default": "rosbot",  "required": true,  "description": "ROSbot agent ID" },
    "hydra_agent_id":     { "type": "string",  "default": "hydra",   "required": true,  "description": "Hydra agent" },
    "camera_agent_id":    { "type": "string",  "default": "camera",  "required": false, "description": "Camera agent" },
    "launch_rosbot":      { "type": "boolean", "default": true,      "required": false, "description": "Stop rosbot docker" },
    "launch_hydra":       { "type": "boolean", "default": true,      "required": false, "description": "Stop hydra roscore and OptiTrack" },
    "launch_camera":      { "type": "boolean", "default": false,     "required": false, "description": "Stop camera roscore and camera launch" }
  },
  "steps": [
    {
      "name": "stop-sensors",
      "type": "parallel",
      "on_failure": "continue",
      "steps": [
        { "name": "stop-optitrack", "type": "command", "when": "${launch_hydra}",  "on_failure": "continue", "agent_id": "${hydra_agent_id}",  "component_id": "ros_bridge", "action": "roslaunch-stop", "timeout_s": 20, "params": {} },
        { "name": "stop-camera",    "type": "command", "when": "${launch_camera}", "on_failure": "continue", "agent_id": "${camera_agent_id}", "component_id": "ros_bridge", "action": "roslaunch-stop", "timeout_s": 20, "params": {} }
      ]
    },

    {
      "name": "stop-ros-environment",
      "type": "parallel",
      "on_failure": "continue",
      "steps": [
        { "name": "stop-roscore-hydra",  "type": "command", "when": "${launch_hydra}",  "on_failure": "continue", "agent_id": "${hydra_agent_id}",  "component_id": "exec", "action": "kill", "timeout_s": 15, "params": { "name": "roscore" } },
        { "name": "stop-roscore-camera", "type": "command", "when": "${launch_camera}", "on_failure": "continue", "agent_id": "${camera_agent_id}", "component_id": "exec", "action": "kill", "timeout_s": 15, "params": { "name": "roscore" } },
        { "name": "stop-rosbot-docker",  "type": "command", "when": "${launch_rosbot}", "on_failure": "continue", "agent_id": "${robot_id}",        "component_id": "exec", "action": "kill", "timeout_s": 15, "params": { "name": "rosbot_docker" } }
      ]
    }
  ]
}
