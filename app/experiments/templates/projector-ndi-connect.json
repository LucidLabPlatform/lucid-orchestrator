{
  "id": "projector-ndi-connect",
  "name": "Projector NDI Connect",
  "version": "1.2.0",
  "description": "Powers on all four projectors, optionally waits for warmup, then starts NDI receive streams. Set projector_warmup_s > 0 to wait before connecting NDI (projectors take several minutes to fully warm up).",
  "tags": ["setup", "projectors", "ndi"],
  "parameters": {
    "north_agent_id":   { "type": "string", "default": "north",                          "required": true,  "description": "Agent ID for the north projector node" },
    "east_agent_id":    { "type": "string", "default": "east",                           "required": true,  "description": "Agent ID for the east projector node" },
    "west_agent_id":    { "type": "string", "default": "west",                           "required": true,  "description": "Agent ID for the west projector node" },
    "ndi_source_north": { "type": "string", "default": "ROBOTICSS-MAC-PRO.LOCAL (north)","required": false, "description": "NDI source name for the north projector" },
    "ndi_source_east":  { "type": "string", "default": "ROBOTICSS-MAC-PRO.LOCAL (east)", "required": false, "description": "NDI source name for the east projector" },
    "ndi_source_west":  { "type": "string", "default": "ROBOTICSS-MAC-PRO.LOCAL (west)", "required": false, "description": "NDI source name for the west projector" },
    "projector_warmup_s": { "type": "float", "default": 0.0, "required": false, "description": "Seconds to wait after powering on before starting NDI streams (0 = skip warmup delay)" }
  },
  "steps": [
    {
      "name": "power_on_projectors",
      "type": "parallel",
      "on_failure": "abort",
      "retries": 0,
      "steps": [
        { "name": "power_on_north", "type": "command", "on_failure": "abort", "retries": 2, "agent_id": "${north_agent_id}", "component_id": "projector", "action": "power/on", "timeout_s": 30, "params": {} },
        { "name": "power_on_east",  "type": "command", "on_failure": "abort", "retries": 2, "agent_id": "${east_agent_id}",  "component_id": "projector", "action": "power/on", "timeout_s": 30, "params": {} },
        { "name": "power_on_west",  "type": "command", "on_failure": "abort", "retries": 2, "agent_id": "${west_agent_id}",  "component_id": "projector", "action": "power/on", "timeout_s": 30, "params": {} }
      ]
    },
    {
      "name": "projector_warmup",
      "type": "delay",
      "on_failure": "abort",
      "duration_s": "${projector_warmup_s}"
    },
    {
      "name": "start_ndi_streams",
      "type": "parallel",
      "on_failure": "abort",
      "retries": 0,
      "steps": [
        { "name": "ndi_north", "type": "command", "on_failure": "abort", "retries": 0, "agent_id": "${north_agent_id}", "component_id": "ndi", "action": "receive/start", "timeout_s": 15, "params": { "stream_name": "${ndi_source_north}" } },
        { "name": "ndi_east",  "type": "command", "on_failure": "abort", "retries": 0, "agent_id": "${east_agent_id}",  "component_id": "ndi", "action": "receive/start", "timeout_s": 15, "params": { "stream_name": "${ndi_source_east}" } },
        { "name": "ndi_west",  "type": "command", "on_failure": "abort", "retries": 0, "agent_id": "${west_agent_id}",  "component_id": "ndi", "action": "receive/start", "timeout_s": 15, "params": { "stream_name": "${ndi_source_west}" } }
      ]
    }
  ]
}
