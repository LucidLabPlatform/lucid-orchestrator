{
  "id": "arena-startup2",
  "name": "Arena Startup2",
  "version": "1.0.0",
  "description": "Powers on all four projectors, connects each to its NDI stream, then starts the arena overlay and TouchDesigner on socrates. Run this before any experiment.",
  "tags": [
    "setup",
    "arena"
  ],
  "parameters": {
    "led_agent_id": {
      "type": "string",
      "default": "led_truss",
      "description": "Agent ID for the OptiTrack ROS bridge",
      "required": true
    },
    "east_agent_id": {
      "type": "string",
      "default": "east",
      "description": "Agent ID for the east projector node",
      "required": true
    },
    "west_agent_id": {
      "type": "string",
      "default": "west",
      "description": "Agent ID for the west projector node",
      "required": true
    },
    "hydra_agent_id": {
      "type": "string",
      "default": "hydra",
      "description": "Agent ID for the Hydra node (hosts KNX component)",
      "required": true
    },
    "north_agent_id": {
      "type": "string",
      "default": "north",
      "description": "Agent ID for the north projector node",
      "required": true
    },
    "south_agent_id": {
      "type": "string",
      "default": "south",
      "description": "Agent ID for the south projector node",
      "required": true
    },
    "socrates_agent_id": {
      "type": "string",
      "default": "socrates",
      "description": "Agent ID running the viz component (arena + TouchDesigner)",
      "required": true
    }
  },
  "steps": [
    {
      "name": "preflight_ping",
      "type": "parallel",
      "on_failure": "abort",
      "retries": 0,
      "steps": [
        {
          "name": "ping_south",
          "type": "command",
          "on_failure": "abort",
          "retries": 0,
          "agent_id": "${south_agent_id}",
          "action": "ping",
          "timeout_s": "10",
          "params": {}
        },
        {
          "name": "ping_north",
          "type": "command",
          "on_failure": "abort",
          "retries": 0,
          "agent_id": "${north_agent_id}",
          "action": "ping",
          "timeout_s": "10",
          "params": {}
        },
        {
          "name": "ping_east",
          "type": "command",
          "on_failure": "abort",
          "retries": 0,
          "agent_id": "${east_agent_id}",
          "action": "ping",
          "timeout_s": "10",
          "params": {}
        },
        {
          "name": "ping_west",
          "type": "command",
          "on_failure": "abort",
          "retries": 0,
          "agent_id": "${west_agent_id}",
          "action": "ping",
          "timeout_s": "10",
          "params": {}
        },
        {
          "name": "ping_socrates",
          "type": "command",
          "on_failure": "abort",
          "retries": 0,
          "agent_id": "${socrates_agent_id}",
          "action": "ping",
          "timeout_s": "10",
          "params": {}
        },
        {
          "name": "ping_led",
          "type": "command",
          "on_failure": "abort",
          "retries": 0,
          "agent_id": "${led_agent_id}",
          "action": "ping",
          "timeout_s": "10",
          "params": {}
        },
        {
          "name": "ping_hydra",
          "type": "command",
          "on_failure": "abort",
          "retries": 0,
          "agent_id": "${hydra_agent_id}",
          "action": "ping",
          "timeout_s": "10",
          "params": {}
        }
      ]
    },
    {
      "name": "led_setup_glow",
      "type": "command",
      "on_failure": "continue",
      "retries": 0,
      "agent_id": "${led_agent_id}",
      "component_id": "led_strip",
      "action": "effect/glow",
      "timeout_s": "10",
      "params": {
        "color": {
          "b": 0,
          "g": 200,
          "r": 255
        },
        "wait_ms": 10
      }
    },
    {
      "name": "power_on_projectors",
      "type": "parallel",
      "on_failure": "abort",
      "retries": 0,
      "steps": [
        {
          "name": "power_on_south",
          "type": "command",
          "on_failure": "abort",
          "retries": 0,
          "agent_id": "${south_agent_id}",
          "component_id": "projector",
          "action": "power/on",
          "timeout_s": "30",
          "params": {}
        },
        {
          "name": "power_on_north",
          "type": "command",
          "on_failure": "abort",
          "retries": 0,
          "agent_id": "${north_agent_id}",
          "component_id": "projector",
          "action": "power/on",
          "timeout_s": "30",
          "params": {}
        },
        {
          "name": "power_on_east",
          "type": "command",
          "on_failure": "abort",
          "retries": 0,
          "agent_id": "${east_agent_id}",
          "component_id": "projector",
          "action": "power/on",
          "timeout_s": "30",
          "params": {}
        },
        {
          "name": "power_on_west",
          "type": "command",
          "on_failure": "abort",
          "retries": 0,
          "agent_id": "${west_agent_id}",
          "component_id": "projector",
          "action": "power/on",
          "timeout_s": "30",
          "params": {}
        }
      ]
    },
    {
      "name": "start_ndi_streams",
      "type": "parallel",
      "on_failure": "abort",
      "retries": 0,
      "steps": [
        {
          "name": "ndi_east",
          "type": "command",
          "on_failure": "abort",
          "retries": 0,
          "agent_id": "${east_agent_id}",
          "component_id": "ndi",
          "action": "receive/start",
          "timeout_s": "15",
          "params": {
            "source": "ROBOTICSS-MAC-PRO.LOCAL (east)"
          }
        },
        {
          "name": "ndi_west",
          "type": "command",
          "on_failure": "abort",
          "retries": 0,
          "agent_id": "${west_agent_id}",
          "component_id": "ndi",
          "action": "receive/start",
          "timeout_s": "15",
          "params": {
            "source": "ROBOTICSS-MAC-PRO.LOCAL (west)"
          }
        },
        {
          "name": "ndi_north",
          "type": "command",
          "on_failure": "abort",
          "retries": 0,
          "agent_id": "${north_agent_id}",
          "component_id": "ndi",
          "action": "receive/start",
          "timeout_s": "15",
          "params": {
            "source": "ROBOTICSS-MAC-PRO.LOCAL (north)"
          }
        },
        {
          "name": "ndi_south",
          "type": "command",
          "on_failure": "abort",
          "retries": 0,
          "agent_id": "${south_agent_id}",
          "component_id": "ndi",
          "action": "receive/start",
          "timeout_s": "15",
          "params": {
            "source": "ROBOTICSS-MAC-PRO.LOCAL (south)"
          }
        }
      ]
    },
    {
      "name": "start_touchdesigner",
      "type": "command",
      "on_failure": "abort",
      "retries": 1,
      "agent_id": "${socrates_agent_id}",
      "component_id": "viz",
      "action": "start_touchdesigner",
      "timeout_s": "30",
      "params": {}
    },
    {
      "name": "start_arena",
      "type": "command",
      "on_failure": "abort",
      "retries": 1,
      "agent_id": "${socrates_agent_id}",
      "component_id": "viz",
      "action": "start_arena",
      "timeout_s": "20",
      "params": {}
    },
    {
      "name": "room_lights_delay",
      "type": "delay",
      "on_failure": "abort",
      "retries": 0,
      "duration_s": "10"
    },
    {
      "name": "set_room_lights",
      "type": "command",
      "on_failure": "continue",
      "retries": 1,
      "agent_id": "${hydra_agent_id}",
      "component_id": "knx",
      "action": "light/brightness/set",
      "timeout_s": "10",
      "params": {
        "light": "Experiments Light",
        "brightness": 1
      }
    },
    {
      "name": "led_set",
      "type": "command",
      "on_failure": "abort",
      "retries": 0,
      "agent_id": "${led_agent_id}",
      "component_id": "led_strip",
      "action": "set_color",
      "timeout_s": "30",
      "params": {
        "color": {
          "b": 0,
          "g": 0,
          "r": 255
        }
      }
    }
  ]
}